    function findSignalPerformanceHeading() {
        const root = document.getElementById(
            "atlas-statistics-dashboard"
        );

        if (!root) {
            return null;
        }

        const candidates = Array.from(
            root.querySelectorAll(
                "h1, h2, h3, h4, h5, h6, "
                + "[class*='title'], "
                + "[class*='heading']"
            )
        );

        return candidates.find(
            function (candidate) {
                const label = normalizeText(
                    candidate.textContent
                );

                return (
                    label.includes(
                        "performance je signal"
                    )
                    || label.includes(
                        "signal performance"
                    )
                    || label.includes(
                        "performance pro signal"
                    )
                );
            }
        ) || null;
    }


    function findSignalPerformanceContainer(
        heading
    ) {
        const root = document.getElementById(
            "atlas-statistics-dashboard"
        );

        if (!root || !heading) {
            return null;
        }

        let node = heading.parentElement;
        let fallback = node;

        while (
            node
            && node !== root
        ) {
            const identity = normalizeText(
                String(node.id || "")
                + " "
                + String(node.className || "")
            );

            if (
                node.matches(
                    "section, article"
                )
                || identity.includes("signal")
                || identity.includes("performance")
                || identity.includes("panel")
                || identity.includes("card")
            ) {
                return node;
            }

            if (
                node.parentElement === root
            ) {
                return node;
            }

            node = node.parentElement;
        }

        return fallback;
    }


    function applySignalPerformanceFocus() {
        clearSignalPerformanceFocus();

        const root = document.getElementById(
            "atlas-statistics-dashboard"
        );

        if (!root) {
            return null;
        }

        const heading = (
            findSignalPerformanceHeading()
        );

        if (!heading) {
            return root;
        }

        const target = (
            findSignalPerformanceContainer(
                heading
            )
        );

        if (
            !target
            || !target.parentElement
            || !root.contains(target)
        ) {
            return root;
        }

        target.setAttribute(
            "data-atlas-signal-performance-root",
            "true"
        );

        target.parentElement.setAttribute(
            "data-atlas-signal-focus-parent",
            "true"
        );

        return target;
    }


    function removeLeadingPinText(element) {
        const walker = document.createTreeWalker(
            element,
            NodeFilter.SHOW_TEXT
        );

        let node = walker.nextNode();

        while (node) {
            const original = String(
                node.nodeValue || ""
            );

            const cleaned = original.replace(
                /^\s*[📌📍]\s*/,
                ""
            );

            if (cleaned !== original) {
                node.nodeValue = cleaned;
                return;
            }

            if (original.trim()) {
                return;
            }

            node = walker.nextNode();
        }
    }




    function createReferencePinSvg(
