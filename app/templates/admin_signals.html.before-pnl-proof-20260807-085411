<style id="project-atlas-signal-three-row-layout">

.atlas-signal-create-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    gap: 18px;
    align-items: start;
}

/* Reihe 1 */
.atlas-field-signal-id {
    grid-row: 1;
    grid-column: 1;
}

.atlas-field-display-name {
    grid-row: 1;
    grid-column: 2;
}

.atlas-field-symbol {
    grid-row: 1;
    grid-column: 3;
}

.atlas-field-direction {
    grid-row: 1;
    grid-column: 4;
}

.atlas-field-timeframe {
    grid-row: 1;
    grid-column: 5;
}

/* Reihe 2 */
.atlas-field-tp1 {
    grid-row: 2;
    grid-column: 1;
}

.atlas-field-tp2 {
    grid-row: 2;
    grid-column: 2;
}

.atlas-field-sl {
    grid-row: 2;
    grid-column: 3;
}

.atlas-field-break-even {
    grid-row: 2;
    grid-column: 4 / span 2;
}

/* Reihe 3 */
.atlas-field-margin {
    grid-row: 3;
    grid-column: 1;
}

.atlas-field-leverage {
    grid-row: 3;
    grid-column: 2;
}

.atlas-field-margin-mode {
    grid-row: 3;
    grid-column: 3;
}

.atlas-field-order-type {
    grid-row: 3;
    grid-column: 4;
}

.atlas-field-enabled {
    grid-row: 3;
    grid-column: 5;
}

.atlas-signal-create-grid details {
    box-sizing: border-box;
    width: 100%;
}

.atlas-form-hint {
    margin-top: 7px;
    color: #64748b;
    font-size: 11px;
    line-height: 1.35;
}

@media (max-width: 1200px) {
    .atlas-signal-create-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: none;
    }

    .atlas-signal-create-grid > * {
        grid-row: auto !important;
        grid-column: auto !important;
    }
}

@media (max-width: 700px) {
    .atlas-signal-create-grid {
        grid-template-columns: 1fr;
    }
}

</style>


