    function updateTpSlPercentPreview(modal) {
        const tpPreview = modal.querySelector("#atlas-modal-tp-preview");
        const slPreview = modal.querySelector("#atlas-modal-sl-preview");
        if (!tpPreview || !slPreview) {
            return;
        }

        const ids = JSON.parse(modal.dataset.positionIds || "[]");
        const tpPercent = Number(modal.querySelector("#atlas-modal-tp")?.value);
        const slPercent = Number(modal.querySelector("#atlas-modal-sl")?.value);

        if (ids.length !== 1) {
            tpPreview.textContent = "Zielpreis wird je Trade aus Entry und Richtung berechnet.";
            slPreview.textContent = "Stop-Preis wird je Trade aus Entry und Richtung berechnet.";
            return;
        }

        const trade = state.trades.get(String(ids[0]));
        if (!trade) {
            tpPreview.textContent = "Keine Preisvorschau verfügbar.";
            slPreview.textContent = "Keine Preisvorschau verfügbar.";
            return;
        }

        if (
            !Number.isFinite(tpPercent)
            || !Number.isFinite(slPercent)
            || tpPercent <= 0
            || slPercent <= 0
        ) {
            tpPreview.textContent = "Positive Prozentdistanz eingeben.";
            slPreview.textContent = "Positive Prozentdistanz eingeben.";
            return;
        }

        try {
            const prices = pricesFromTpSlPercent(trade, tpPercent, slPercent);
            tpPreview.innerHTML = "Berechneter TP-Preis: <strong>" + formatPrice(prices.tpPrice) + "</strong>";
            slPreview.innerHTML = "Berechneter SL-Preis: <strong>" + formatPrice(prices.slPrice) + "</strong>";
        } catch (error) {
            tpPreview.textContent = "Preisvorschau nicht möglich.";
            slPreview.textContent = "Preisvorschau nicht möglich.";
        }
    }

    function priceFromEntryPercent(
        trade,
        type,
        percent
    ) {
        const entry = numberOrNull(
            trade?.entry_price
        );

        const distance = Number(percent);

        if (
            entry === null
            || entry <= 0
            || !Number.isFinite(distance)
            || distance <= 0
            || distance >= 100
        ) {
            throw new Error(
                "Ungültige prozentuale Preisdifferenz."
            );
        }

        const short = (
            directionOf(trade) === "SHORT"
        );

        let price = null;

        if (type === "tp") {
            price = short
                ? entry * (1 - distance / 100)
                : entry * (1 + distance / 100);
        } else {
            price = short
                ? entry * (1 + distance / 100)
                : entry * (1 - distance / 100);
        }

        if (
            !Number.isFinite(price)
            || price <= 0
        ) {
            throw new Error(
                "Berechneter TP-/SL-Preis ist ungültig."
            );
        }

        return Number(
            price.toFixed(12)
        );
    }


