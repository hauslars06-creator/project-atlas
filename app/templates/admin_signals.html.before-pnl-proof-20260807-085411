    function markManualTradeRows() {
        const manualTable = (
            findManualTradeTable()
        );

        if (!manualTable) {
            return;
        }

        const rows = manualTable.querySelectorAll(
            "tbody tr"
        );

        for (const row of rows) {
            const rowText = normalizeText(
                row.textContent
            );

            const isManualTrade = (
                rowText.includes(
                    "manueller trade"
                )
                || rowText.includes(
                    "manueller bitunix-trade"
                )
                || rowText.includes(
                    "manuell"
                )
            );

            if (!isManualTrade) {
                continue;
            }

            const firstCell = (
                row.cells
                && row.cells.length
                    ? row.cells[0]
                    : null
            );

            if (!firstCell) {
                continue;
            }

            row.classList.add(
                "atlas-manual-trade-row",
                "atlas-manual-trade-row-v3"
            );

            firstCell.classList.add(
                "atlas-pin-cell",
                "atlas-pin-cell-v3"
            );

            const oldReferencePins = (
                firstCell.querySelectorAll(
                    ".atlas-reference-row-pin-v3"
                )
            );

            if (oldReferencePins.length > 1) {
                for (
                    const duplicate
                    of Array.from(
                        oldReferencePins
                    ).slice(1)
                ) {
                    duplicate.remove();
                }
            }

            if (!oldReferencePins.length) {
                firstCell.append(
                    createReferencePinSvg(
                        "atlas-reference-row-pin-v3",
                        17
                    )
                );
            }
        }
    }



    function findDeepestManualHeadingElement(
        root
    ) {
        const candidates = Array.from(
            root.querySelectorAll("*")
        ).filter(
            function (element) {
                if (
                    element.classList.contains(
                        "atlas-manual-header-fixed-content-v3"
                    )
                    || element.closest(
                        ".atlas-manual-header-fixed-content-v3"
                    )
                ) {
                    return false;
                }

                const label = normalizeText(
                    element.textContent
                );

                const matches = (
                    label.includes(
                        "gesperrte trades"
                    )
                    || label.includes(
                        "manuell auf bitunix eröffnet"
                    )
                );

                if (!matches) {
                    return false;
                }

                const matchingChild = (
                    Array.from(
                        element.children
                    ).some(
                        function (child) {
                            const childLabel = (
                                normalizeText(
                                    child.textContent
                                )
                            );

                            return (
                                childLabel.includes(
                                    "gesperrte trades"
                                )
                                || childLabel.includes(
                                    "manuell auf bitunix eröffnet"
                                )
                            );
                        }
                    )
                );

                return !matchingChild;
            }
        );

        candidates.sort(
            function (left, right) {
                return (
                    String(
                        left.textContent || ""
                    ).length
                    - String(
                        right.textContent || ""
                    ).length
                );
            }
        );

        return candidates[0] || null;
    }


    function determineManualHeaderContainer(
        root,
        heading,
        manualTable
    ) {
        if (!heading) {
            return null;
        }

        let container = heading;

        while (
            container.parentElement
            && container.parentElement !== root
            && !container.parentElement.contains(
                manualTable
            )
        ) {
            container = (
                container.parentElement
            );
        }

        if (
            container === heading
            && heading.parentElement
            && heading.parentElement !== root
            && !heading.parentElement.contains(
                manualTable
            )
        ) {
            container = (
                heading.parentElement
            );
        }

        if (
            container === root
            || container.contains(
                manualTable
            )
        ) {
            return null;
        }

        return container;
    }


