     */

    function targetHtml(trade, type) {
        const targetType = type === "sl" ? "sl" : "tp";
        const label = targetType === "tp" ? "TP" : "SL";
        const levels = normalizedTpSlLevels(trade, targetType);
        const positionId = escapeHtml(trade.position_id ?? "");
        const locked = Boolean(trade.is_locked);

        const editTitle = locked
            ? "Trade ist gesperrt – zum Bearbeiten zuerst entsperren"
            : (
                label
                + " als Preisabstand vom Entry in Prozent bearbeiten"
            );

        const rows = levels.map(function (level, index) {
            const price = numberOrNull(level?.price);
            const percent = targetPercent(trade, price);
            const quantity = formatTpSlQuantity(level?.quantity);

            const tooltipParts = [
                label + String(index + 1),
                price > 0 ? "Preis " + formatPrice(price) : "",
                numberOrNull(percent) !== null
                    ? formatSigned(percent, "%")
                    : "",
                quantity ? "Menge " + quantity : "",
                String(level?.stop_type ?? "").trim(),
                String(level?.order_type ?? "").trim(),
                level?.order_id
                    ? "Order " + String(level.order_id)
                    : ""
            ].filter(Boolean);

            return `
                <div
                    class="
                        atlas-tpsl-v56-level
                        atlas-tpsl-v56-level-${targetType}
                    "
                    title="${
                        escapeHtml(
                            tooltipParts.join(" · ")
                        )
                    }"
                >
                    <span
                        class="
                            atlas-tpsl-v56-badge
                            ${targetType}
                        "
                    >
                        ${label}${index + 1}
                    </span>

                    <span class="atlas-tpsl-v56-price">
                        ${
                            price > 0
                                ? formatPrice(price)
                                : "–"
                        }
                    </span>

                    <span
