<script id="project-atlas-pnl-active-locked-final">
(function () {
    "use strict";

    const state = {
        scope: "ACTIVE",
        days: 30,
        openTrades: [],
        historyTrades: [],
        requestRunning: false
    };

    const formatter = new Intl.NumberFormat(
        "de-DE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

    function numberOf(value) {
        const number = Number(value);

        return Number.isFinite(number)
            ? number
            : 0;
    }

    function openPnlOf(trade) {
        const value = Number(
            trade?.unrealized_pnl
        );

        return Number.isFinite(value)
            ? value
            : 0;
    }

    function marginOf(trade) {
        const current = Number(
            trade?.current_margin
        );

        if (
            Number.isFinite(current)
            && current > 0
        ) {
            return current;
        }

        return numberOf(
            trade?.margin_usdt
        );
    }

    function isAtlasOpenTrade(trade) {
        return String(
            trade?.trade_source ?? ""
        )
            .trim()
            .toUpperCase() === "ATLAS";
    }

    function isAtlasHistoryTrade(trade) {
        const signalId = String(
            trade?.signal_id ?? ""
        )
            .trim()
            .toUpperCase();

        const timeframe = String(
            trade?.timeframe ?? ""
        )
            .trim()
            .toUpperCase();

        return (
            signalId !== "EXTERNAL"
            && timeframe !== "MANUAL"
        );
    }

    function dateOf(value) {
        if (!value) {
            return null;
        }

        const date = new Date(value);

        return Number.isNaN(date.getTime())
            ? null
            : date;
    }

    function sameLocalDay(a, b) {
        return (
            a.getFullYear() === b.getFullYear()
            && a.getMonth() === b.getMonth()
            && a.getDate() === b.getDate()
        );
    }

    function insidePeriod(value) {
        const date = dateOf(value);

        if (!date) {
            return false;
        }

        const now = new Date();

        if (state.days === 0) {
            return sameLocalDay(
                date,
                now
            );
        }

        const cutoff = new Date(now);

        cutoff.setDate(
            cutoff.getDate() - state.days
        );

        return date >= cutoff;
    }

    function selectedOpenTrades() {
        return state.openTrades;
    }

    function selectedHistoryTrades() {
        return state.historyTrades;
    }


    function signedText(value, suffix = "") {
        return (
            (value > 0 ? "+" : "")
            + formatter.format(value)
            + suffix
        );
    }

    function valueClass(base, value) {
        if (value > 0) {
            return base + " positive";
        }

        if (value < 0) {
            return base + " negative";
        }

        return base;
    }

    function periodLabel() {
        if (state.days === 0) {
            return "Heute";
        }

        return state.days + " Tage";
    }

    function render() {
        const openTrades =
            selectedOpenTrades();

        const historyTrades =
            selectedHistoryTrades();

        const openPnl = openTrades.reduce(
            (sum, trade) =>
                sum + openPnlOf(trade),
            0
        );

        const historyPnl =
            historyTrades.reduce(
                (sum, trade) =>
                    sum
                    + numberOf(
                        trade?.pnl_usdt
                    ),
                0
            );

        const totalPnl =
            openPnl + historyPnl;

        const totalMargin = [
            ...openTrades,
            ...historyTrades
        ].reduce(
            (sum, trade) =>
                sum + marginOf(trade),
            0
        );

        const roi = totalMargin > 0
            ? totalPnl / totalMargin * 100
            : 0;

        const pnlNode =
            document.getElementById(
                "atlas-live-scope-pnl"
            );

        const roiNode =
            document.getElementById(
                "atlas-live-scope-roi"
            );

        const labelNode =
            document.getElementById(
                "atlas-live-scope-label"
            );

        if (pnlNode) {
            pnlNode.textContent =
                signedText(totalPnl);

            pnlNode.className = valueClass(
                "atlas-reference-kpi-value",
                totalPnl
            );
        }

        if (roiNode) {
            roiNode.textContent =
                signedText(roi, " % ROI");

            roiNode.className = valueClass(
                "atlas-reference-kpi-meta",
                roi
            );
        }

        if (labelNode) {
            const scopeLabel = (
                state.scope === "LOCKED"
                    ? "Gesperrte Trades"
                    : "Aktive Signal-Trades"
            );

            labelNode.textContent = (
                scopeLabel
                + " · "
                + periodLabel()
            );
        }

        document.querySelectorAll(
            '[data-kpi-switcher="pnl-scope"] '
            + 'button[data-pnl-scope]'
        ).forEach(function (button) {
            button.classList.toggle(
                "active",
                button.dataset.pnlScope
                === state.scope
            );
        });

        document.querySelectorAll(
            '[data-kpi-switcher="pnl-scope"] '
            + 'button[data-pnl-days]'
        ).forEach(function (button) {
            button.classList.toggle(
                "active",
                Number(
                    button.dataset.pnlDays
                ) === state.days
            );
        });
    }

    function extractTrades(payload) {
        return Array.isArray(payload?.trades)
            ? payload.trades
            : [];
    }

    async function fetchHistory() {
        const historyDays = (
            state.days === 0
                ? 1
                : state.days
        );

        const lockScopeParam = (
            state.scope === "LOCKED"
                ? "&lock_scope=LOCKED"
                : "&lock_scope=ACTIVE"
        );

        const firstUrl = (
            "/api/v1/trades/history"
            + "?days=" + historyDays
            + lockScopeParam
            + "&sort_by=closed_at"
            + "&sort_dir=desc"
            + "&page=1"
            + "&per_page=100"
        );

        const firstResponse =
            await fetch(
                firstUrl,
                {cache: "no-store"}
            );

        if (!firstResponse.ok) {
            return [];
        }

        const firstPayload =
            await firstResponse.json();

        const trades = extractTrades(
            firstPayload
        );

        const totalPages = Number(
            firstPayload?.total_pages
            ?? 1
        );

        for (
            let page = 2;
            page <= totalPages;
            page += 1
        ) {
            const response = await fetch(
                firstUrl.replace(
                    "page=1",
                    "page=" + page
                ),
                {cache: "no-store"}
            );

            if (!response.ok) {
                continue;
            }

            const payload =
                await response.json();

            trades.push(
                ...extractTrades(payload)
            );
        }

        return trades;
    }

    async function refresh() {
        if (state.requestRunning) {
            return;
        }

        state.requestRunning = true;

        try {
            const [
                openResponse,
                historyTrades
            ] = await Promise.all([
                fetch(
                    "/api/v1/trades/open",
                    {cache: "no-store"}
                ),
                fetchHistory()
            ]);

            if (openResponse.ok) {
                const openPayload =
                    await openResponse.json();

                state.openTrades =
                    extractTrades(openPayload);
            }

            state.historyTrades =
                historyTrades;

            render();

        } catch (error) {
            console.error(
                "Gesamt-PnL konnte nicht "
                + "aktualisiert werden:",
                error
            );

        } finally {
            state.requestRunning = false;
        }
    }

    document.addEventListener(
        "click",
        function (event) {
            const scopeButton =
                event.target.closest(
                    '[data-kpi-switcher="pnl-scope"] '
                    + 'button[data-pnl-scope]'
                );

            if (scopeButton) {
                const scope = String(
                    scopeButton.dataset.pnlScope
                    ?? ""
                ).toUpperCase();

                if (
                    scope === "ACTIVE"
                    || scope === "LOCKED"
                ) {
                    state.scope = scope;
                    render();
                }

                return;
            }

            const daysButton =
                event.target.closest(
                    '[data-kpi-switcher="pnl-scope"] '
                    + 'button[data-pnl-days]'
                );

            if (!daysButton) {
                return;
            }

            const days = Number(
                daysButton.dataset.pnlDays
            );

            if (![0, 7, 14, 30].includes(days)) {
                return;
            }

            state.days = days;

            /*
             * Der History-Endpunkt wird passend zum
             * neuen Zeitraum erneut geladen.
             */
            refresh();
        }
    );

    function start() {
        refresh();

        window.setInterval(
            refresh,
            5000
        );
    }

    if (
        document.readyState === "loading"
    ) {
        document.addEventListener(
            "DOMContentLoaded",
            start,
            {once: true}
        );
    } else {
        start();
    }
})();
</script>




<script id="project-atlas-signal-three-row-script">
(function () {
    "use strict";

    function directGridChild(field, grid) {
        let node = field;

        while (
            node
            && node.parentElement
            && node.parentElement !== grid
        ) {
            node = node.parentElement;
        }

        return (
            node
            && node.parentElement === grid
                ? node
                : null
        );
    }

    function markField(grid, selector, className) {
        const field = grid.querySelector(selector);

        if (!field) {
            return;
        }

        const wrapper = directGridChild(
            field,
            grid
        );

        if (wrapper) {
            wrapper.classList.add(className);
        }
    }

    function initializeSignalForm() {
        const grid = document.querySelector(
            ".atlas-signal-create-grid"
        );

        if (!grid) {
            return;
        }

        const mappings = [
            ['[name="signal_id"]', "atlas-field-signal-id"],
            ['[name="display_name"]', "atlas-field-display-name"],
            ['[name="symbol"]', "atlas-field-symbol"],
            ['[name="direction"]', "atlas-field-direction"],
            ['[name="timeframe"]', "atlas-field-timeframe"],
            ['[name="take_profit_percent"]', "atlas-field-tp1"],
            ['[name="take_profit_2_percent"]', "atlas-field-tp2"],
            ['[name="stop_loss_percent"]', "atlas-field-sl"],
            ['[name="break_even_trigger"]', "atlas-field-break-even"],
            ['[name="margin_usdt"]', "atlas-field-margin"],
            ['[name="leverage"]', "atlas-field-leverage"],
            ['[name="margin_mode"]', "atlas-field-margin-mode"],
            ['[name="order_type"]', "atlas-field-order-type"],
            ['[name="enabled"]', "atlas-field-enabled"]
        ];

        mappings.forEach(function (mapping) {
            markField(
                grid,
                mapping[0],
                mapping[1]
            );
        });;

            details.addEventListener(
                "toggle",
                synchronizeTp2
            );

            synchronizeTp2();
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initializeSignalForm,
            {once: true}
        );
    } else {
        initializeSignalForm();
    }
})();
</script>

