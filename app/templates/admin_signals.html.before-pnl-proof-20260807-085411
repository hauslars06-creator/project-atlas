<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Project Atlas Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            background: #0f172a;
            color: #e2e8f0;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 1600px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        h1,
        h2 {
            margin-top: 0;
        }

        h1 {
            margin-bottom: 5px;
        }

        h2 {
            margin-bottom: 18px;
        }

        .subtitle,
        .muted {
            color: #94a3b8;
        }

        .section {
            margin-bottom: 35px;
        }

        .status-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(180px, 1fr));
            gap: 16px;
            margin-bottom: 35px;
        }

        .status-card {
            padding: 20px;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
        }

        .status-label {
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .status-value {
            font-size: 24px;
            font-weight: bold;
        }

        .online {
            color: #4ade80;
        }

        .new-button,
        .edit-button {
            display: inline-block;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
        }

        .new-button {
            padding: 12px 18px;
            background: #2563eb;
            color: white;
        }

        .edit-button {
            padding: 8px 12px;
            background: #475569;
            color: white;
        }

        .delete-button {
            padding: 8px 12px;
            margin-left: 6px;
            border: none;
            border-radius: 6px;
            background: #991b1b;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        .card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 950px;
        }

        th,
        td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #334155;
            white-space: nowrap;
        }

        th {
            background: #334155;
            color: #cbd5e1;
            font-size: 14px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .long {
            color: #4ade80;
            font-weight: bold;
        }

        .short {
            color: #f87171;
            font-weight: bold;
        }

        .active,
        .open-status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            background: #14532d;
            color: #86efac;
        }

        .paused {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            background: #7f1d1d;
            color: #fca5a5;
        }

        .signal-id {
            color: #94a3b8;
            font-size: 13px;
        }

        button.active,
        button.paused {
            border: none;
            cursor: pointer;
            font: inherit;
        }

        .actions {
            white-space: nowrap;
        }

        .delete-form {
            display: inline-block;
        }

        .empty-state {
            padding: 30px;
            text-align: center;
            color: #94a3b8;
        }

        /* PROJECT ATLAS M4.6A START */

        .atlas-section-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .atlas-section-heading h2 {
            margin-right: auto;
        }

        .atlas-close-all-button {
            padding: 10px 14px;
            border: 1px solid #ef4444;
            border-radius: 8px;
            background: #7f1d1d;
            color: #fee2e2;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition:
                background 0.15s ease,
                opacity 0.15s ease,
                transform 0.15s ease;
        }

        .atlas-close-all-button:hover:not(:disabled) {
            background: #991b1b;
            transform: translateY(-1px);
        }

        .atlas-close-all-button:disabled {
            cursor: wait;
            opacity: 0.65;
        }

        /*
         * Beide Signalspalten verwenden exakt dieselbe Breite,
         * Schriftgröße und Darstellung.
         */
        .atlas-signal-column {
            width: 220px;
            min-width: 220px;
            max-width: 220px;
            font-size: 14px;
        }

        td.atlas-signal-column {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /*
         * Stabile PnL-Spalten:
         * feste Breite und gleich breite Ziffern verhindern Springen.
         */
        .atlas-pnl-column {
            width: 150px;
            min-width: 150px;
            max-width: 150px;
            text-align: right;
            font-variant-numeric: tabular-nums;
            font-feature-settings: "tnum" 1;
            white-space: nowrap;
        }

        .atlas-action-message {
            display: none;
            margin: 12px 0 0;
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 14px;
        }

        .atlas-action-message.success {
            display: block;
            border: 1px solid #166534;
            background: #14532d;
            color: #bbf7d0;
        }

        .atlas-action-message.error {
            display: block;
            border: 1px solid #991b1b;
            background: #7f1d1d;
            color: #fecaca;
        }

        /* PROJECT ATLAS M4.6A END */

        /* PROJECT ATLAS M4.6B START */

        .atlas-lock-column {
            width: 142px;
            min-width: 142px;
            max-width: 142px;
            text-align: center;
        }

        .atlas-lock-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 118px;
            padding: 8px 10px;
            border-radius: 8px;
            font: inherit;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition:
                background 0.15s ease,
                border-color 0.15s ease,
                opacity 0.15s ease,
                transform 0.15s ease;
        }

        .atlas-lock-toggle:hover:not(:disabled) {
            transform: translateY(-1px);
        }

        .atlas-lock-toggle.unlocked {
            border: 1px solid #475569;
            background: #334155;
            color: #e2e8f0;
        }

        .atlas-lock-toggle.unlocked:hover:not(:disabled) {
            border-color: #f59e0b;
            background: #475569;
        }

        .atlas-lock-toggle.locked {
            border: 1px solid #f59e0b;
            background: #78350f;
            color: #fde68a;
        }

        .atlas-lock-toggle.locked:hover:not(:disabled) {
            background: #92400e;
        }

        .atlas-lock-toggle:disabled {
            cursor: wait;
            opacity: 0.6;
        }

        .atlas-lock-icon {
            font-size: 15px;
            line-height: 1;
        }

        #atlas-lock-message {
            margin-top: 8px;
        }

        /* Backend-Sperrfeld: is_locked */

        /* PROJECT ATLAS M4.6B END */

        /* PROJECT ATLAS M4.6C START */

        /*
         * Alle Spaltenüberschriften der Tabellen
         * „Offene Trades“ und „Trade-Historie“
         * horizontal zentrieren.
         */
        #open-trades-table thead th,
        #trade-history-table thead th {
            text-align: center !important;
            vertical-align: middle;
        }

        /* PROJECT ATLAS M4.6C END */

        /* PROJECT ATLAS M4.6D START */

        /*
         * Auch alle Überschriften der unteren
         * Signale-Tabelle zentrieren.
         */
        #signals-table thead th {
            text-align: center !important;
            vertical-align: middle;
        }

        /*
         * Aktionsspalte bleibt am rechten Tabellenrand
         * kompakt und mittig ausgerichtet.
         */
        #open-trades-table th.atlas-lock-column,
        #open-trades-table td.atlas-lock-column {
            text-align: center !important;
            vertical-align: middle;
        }

        /* PROJECT ATLAS M4.6D END */

        /* PROJECT ATLAS M5.2A START */

        .atlas-statistics-dashboard {
            margin-bottom: 28px;
        }

        .atlas-statistics-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 16px;
        }

        .atlas-statistics-header h2 {
            margin: 0;
        }

        .atlas-period-filter {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        .atlas-period-button {
            border: 1px solid #334155;
            border-radius: 8px;
            background: #0f172a;
            color: #cbd5e1;
            padding: 9px 13px;
            font: inherit;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition:
                background 0.15s ease,
                border-color 0.15s ease,
                color 0.15s ease;
        }

        .atlas-period-button:hover {
            border-color: #3b82f6;
            color: #ffffff;
        }

        .atlas-period-button.active {
            border-color: #2563eb;
            background: #2563eb;
            color: #ffffff;
        }

        .atlas-kpi-grid {
            display: grid;
            grid-template-columns:
                repeat(5, minmax(150px, 1fr));
            gap: 14px;
        }

        .atlas-kpi-card {
            min-height: 112px;
            padding: 18px;
            border: 1px solid #1e293b;
            border-radius: 12px;
            background:
                linear-gradient(
                    145deg,
                    #111c31,
                    #0f172a
                );
            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.18);
        }

        .atlas-kpi-label {
            margin-bottom: 11px;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .atlas-kpi-value {
            color: #f8fafc;
            font-size: 25px;
            font-weight: 800;
            line-height: 1.2;
        }

        .atlas-kpi-value.positive {
            color: #22c55e;
        }

        .atlas-kpi-value.negative {
            color: #ef4444;
        }

        .atlas-kpi-value.neutral {
            color: #f8fafc;
        }

        .atlas-kpi-meta {
            margin-top: 8px;
            color: #64748b;
            font-size: 12px;
        }

        .atlas-detail-grid {
            display: grid;
            grid-template-columns:
                repeat(6, minmax(130px, 1fr));
            gap: 12px;
            margin-top: 14px;
        }

        .atlas-detail-card {
            padding: 14px 15px;
            border: 1px solid #1e293b;
            border-radius: 10px;
            background: #0b1220;
        }

        .atlas-detail-label {
            margin-bottom: 7px;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .atlas-detail-value {
            color: #e2e8f0;
            font-size: 16px;
            font-weight: 800;
        }

        .atlas-statistics-message {
            display: none;
            margin-top: 12px;
            padding: 11px 13px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
        }

        .atlas-statistics-message.error {
            display: block;
            border: 1px solid #991b1b;
            background: #7f1d1d;
            color: #fecaca;
        }

        .atlas-performance-panel {
            margin-top: 22px;
        }

        .atlas-performance-panel h3 {
            margin: 0 0 14px;
            color: #f8fafc;
            font-size: 18px;
        }

        .atlas-performance-table-wrapper {
            overflow-x: auto;
        }

        #atlas-signal-performance-table {
            width: 100%;
        }

        #atlas-signal-performance-table th {
            text-align: center;
            vertical-align: middle;
        }

        #atlas-signal-performance-table td {
            text-align: center;
            vertical-align: middle;
        }

        #atlas-signal-performance-table td:first-child {
            min-width: 280px;
            text-align: left;
        }

        .atlas-performance-name {
            color: #f8fafc;
            font-weight: 700;
        }

        .atlas-performance-id {
            display: block;
            margin-top: 4px;
            color: #64748b;
            font-size: 11px;
        }

        .atlas-stat-positive {
            color: #22c55e;
            font-weight: 800;
        }

        .atlas-stat-negative {
            color: #ef4444;
            font-weight: 800;
        }

        .atlas-stat-neutral {
            color: #cbd5e1;
            font-weight: 700;
        }

        .atlas-statistics-loading {
            opacity: 0.65;
            pointer-events: none;
        }

        @media (max-width: 1250px) {
            .atlas-kpi-grid {
                grid-template-columns:
                    repeat(3, minmax(160px, 1fr));
            }

            .atlas-detail-grid {
                grid-template-columns:
                    repeat(3, minmax(140px, 1fr));
            }
        }

        @media (max-width: 760px) {
            .atlas-statistics-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .atlas-kpi-grid,
            .atlas-detail-grid {
                grid-template-columns: 1fr;
            }

            .atlas-period-filter {
                width: 100%;
            }

            .atlas-period-button {
                flex: 1 1 auto;
            }
        }

        /* PROJECT ATLAS M5.2A END */

        /* PROJECT ATLAS M5.2A CLEAN DARK UPGRADE START */

        :root {
            --atlas-sidebar-width: 214px;
            --atlas-topbar-height: 68px;

            --atlas-bg: #050b12;
            --atlas-bg-soft: #07111c;
            --atlas-sidebar-bg: #040a10;

            --atlas-panel: #09131f;
            --atlas-panel-soft: #0c1826;
            --atlas-panel-hover: #101f30;

            --atlas-border: #1b2d40;
            --atlas-border-soft: #132334;

            --atlas-text: #e8eef6;
            --atlas-muted: #8190a3;
            --atlas-muted-soft: #647386;

            --atlas-blue: #168bff;
            --atlas-cyan: #10d7ff;
            --atlas-green: #10d977;
            --atlas-red: #ff4d58;
            --atlas-yellow: #ffc83d;
            --atlas-purple: #eb9cff;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding: 0 !important;
            background:
                radial-gradient(
                    circle at 65% -10%,
                    rgba(10, 92, 150, 0.12),
                    transparent 38%
                ),
                linear-gradient(
                    180deg,
                    #050b12 0%,
                    #06101a 100%
                );
            color: var(--atlas-text);
        }

        .atlas-app-shell {
            min-height: 100vh;
        }

        .atlas-sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 1000;
            width: var(--atlas-sidebar-width);
            border-right: 1px solid var(--atlas-border);
            background:
                linear-gradient(
                    180deg,
                    #050b12 0%,
                    #03080d 100%
                );
            box-shadow:
                8px 0 28px rgba(0, 0, 0, 0.22);
            overflow-y: auto;
        }

        .atlas-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            height: var(--atlas-topbar-height);
            padding: 0 18px;
            border-bottom: 1px solid var(--atlas-border-soft);
            color: #ffffff;
            font-size: 13px;
            font-weight: 800;
        }

        .atlas-brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 25px;
            height: 25px;
            border: 1px solid var(--atlas-cyan);
            border-radius: 50%;
            color: var(--atlas-cyan);
            font-size: 14px;
            box-shadow:
                0 0 12px rgba(16, 215, 255, 0.16);
        }

        .atlas-nav-group {
            padding: 17px 0 5px;
        }

        .atlas-nav-label {
            padding: 0 16px 8px;
            color: #687789;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .atlas-nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 41px;
            padding: 0 16px;
            border-left: 3px solid transparent;
            color: #b8c4d1;
            font-size: 12px;
            text-decoration: none;
            transition:
                background 0.15s ease,
                border-color 0.15s ease,
                color 0.15s ease;
        }

        .atlas-nav-link:hover {
            background: rgba(22, 139, 255, 0.07);
            color: #ffffff;
        }

        .atlas-nav-link.active {
            border-left-color: var(--atlas-blue);
            background:
                linear-gradient(
                    90deg,
                    rgba(22, 139, 255, 0.18),
                    rgba(22, 139, 255, 0.025)
                );
            color: var(--atlas-blue);
        }

        .atlas-nav-icon {
            width: 18px;
            text-align: center;
            font-size: 14px;
        }

        .atlas-version {
            padding: 24px 17px;
            color: #687789;
            font-size: 10px;
        }

        .atlas-main {
            min-height: 100vh;
            margin-left: var(--atlas-sidebar-width);
        }

        .atlas-topbar {
            position: sticky;
            top: 0;
            z-index: 900;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: var(--atlas-topbar-height);
            padding: 0 22px;
            border-bottom: 1px solid var(--atlas-border);
            background: rgba(5, 11, 18, 0.95);
            backdrop-filter: blur(16px);
        }

        .atlas-topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .atlas-menu-icon {
            color: #8090a2;
            font-size: 19px;
        }

        .atlas-page-title {
            color: #ffffff;
            font-size: 19px;
            font-weight: 800;
            line-height: 1.05;
        }

        .atlas-page-subtitle {
            margin-top: 3px;
            color: #8090a2;
            font-size: 11px;
        }

        .atlas-topbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
            color: #bcc8d5;
            font-size: 11px;
        }

        .atlas-refresh-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .atlas-refresh-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--atlas-green);
            box-shadow:
                0 0 9px rgba(16, 217, 119, 0.7);
        }

        .atlas-refresh-badge {
            padding: 5px 9px;
            border-radius: 12px;
            background: rgba(16, 217, 119, 0.10);
            color: var(--atlas-green);
            font-weight: 800;
        }

        .atlas-admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .atlas-admin-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border: 1px solid #66778a;
            border-radius: 50%;
            color: #dce5ef;
            font-size: 11px;
        }

        .atlas-main > .container {
            width: auto;
            max-width: none;
            margin: 0;
            padding: 18px 16px 34px;
        }

        .atlas-main .header {
            display: none;
        }

        .atlas-reference-kpis {
            display: grid;
            grid-template-columns:
                repeat(5, minmax(165px, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .atlas-reference-kpi {
            position: relative;
            min-height: 105px;
            padding: 16px 17px;
            overflow: hidden;
            border: 1px solid var(--atlas-border);
            border-radius: 7px;
            background:
                linear-gradient(
                    150deg,
                    rgba(10, 23, 37, 0.98),
                    rgba(7, 16, 26, 0.98)
                );
            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.18);
        }

        .atlas-reference-kpi::after {
            content: "";
            position: absolute;
            right: -20px;
            bottom: -42px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background:
                radial-gradient(
                    circle,
                    rgba(22, 139, 255, 0.08),
                    transparent 68%
                );
            pointer-events: none;
        }

        .atlas-reference-kpi.pnl {
            border-color: rgba(16, 217, 119, 0.25);
        }

        .atlas-reference-kpi.pnl::after {
            background:
                radial-gradient(
                    circle,
                    rgba(16, 217, 119, 0.10),
                    transparent 68%
                );
        }

        .atlas-reference-kpi.margin {
            border-color: rgba(255, 200, 61, 0.24);
            background:
                linear-gradient(
                    150deg,
                    rgba(31, 27, 14, 0.92),
                    rgba(9, 16, 24, 0.98)
                );
        }

        .atlas-reference-kpi.balance {
            border-color: rgba(16, 215, 255, 0.24);
        }

        .atlas-reference-kpi-label {
            color: var(--atlas-blue);
            font-size: 11px;
            font-weight: 700;
        }

        .atlas-reference-kpi.pnl
        .atlas-reference-kpi-label {
            color: var(--atlas-green);
        }

        .atlas-reference-kpi.winrate
        .atlas-reference-kpi-label {
            color: var(--atlas-purple);
        }

        .atlas-reference-kpi.margin
        .atlas-reference-kpi-label {
            color: var(--atlas-yellow);
        }

        .atlas-reference-kpi.balance
        .atlas-reference-kpi-label {
            color: var(--atlas-cyan);
        }

        .atlas-reference-kpi-period {
            margin-top: 3px;
            color: #8f9cae;
            font-size: 10px;
        }

        .atlas-reference-kpi-value {
            margin-top: 11px;
            color: #ffffff;
            font-size: 24px;
            font-weight: 500;
            line-height: 1;
        }

        .atlas-reference-kpi-value.positive {
            color: var(--atlas-green);
        }

        .atlas-reference-kpi-value.negative {
            color: var(--atlas-red);
        }

