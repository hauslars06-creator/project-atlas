<script id="project-atlas-dashboard-live-kpi-switchers">
(function () {
    "use strict";

    const state = {
        openDirection: "ALL",
        marginDirection: "ALL",
        trades: [],
    };

    const formatter = new Intl.NumberFormat(
        "de-DE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        }
    );

    function normalizeDirection(trade) {
        return String(
            trade?.direction
            ?? trade?.side
            ?? ""
        ).trim().toUpperCase();
    }

    function marginOf(trade) {
        const current = Number(
            trade?.current_margin
        );

        if (
            Number.isFinite(current)
            && current > 0
        ) {
            return current;
        }

        const fallback = Number(
            trade?.margin_usdt
        );

        return Number.isFinite(fallback)
            ? fallback
            : 0;
    }

    function filterDirection(
        trades,
        direction
    ) {
        if (direction === "ALL") {
            return trades;
        }

        return trades.filter(
            trade =>
                normalizeDirection(trade)
                === direction
        );
    }

    function countDirection(direction) {
        return filterDirection(
            state.trades,
            direction
        ).length;
    }

    function marginDirection(direction) {
        return filterDirection(
            state.trades,
            direction
        ).reduce(
            (total, trade) =>
                total + marginOf(trade),
            0
        );
    }

    function render() {
        const openCount =
            document.getElementById(
                "atlas-kpi-open-count"
            );

        const openBreakdown =
            document.getElementById(
                "atlas-open-trades-breakdown"
            );

        const totalMargin =
            document.getElementById(
                "atlas-kpi-total-margin"
            );

        const marginBreakdown =
            document.getElementById(
                "atlas-margin-breakdown"
            );

        if (openCount) {
            openCount.textContent =
                countDirection(
                    state.openDirection
                );
        }

        if (openBreakdown) {
            openBreakdown.textContent = (
                countDirection("LONG")
                + " Long / "
                + countDirection("SHORT")
                + " Short"
            );
        }

        if (totalMargin) {
            totalMargin.textContent =
                formatter.format(
                    marginDirection(
                        state.marginDirection
                    )
                );
        }

        if (marginBreakdown) {
            marginBreakdown.textContent = (
                "Gesamt "
                + formatter.format(
                    marginDirection("ALL")
                )
                + " · Long "
                + formatter.format(
                    marginDirection("LONG")
                )
                + " · Short "
                + formatter.format(
                    marginDirection("SHORT")
                )
            );
        }
    }

    function extractTrades(payload) {
        if (Array.isArray(payload)) {
            return payload;
        }

        if (Array.isArray(payload?.trades)) {
            return payload.trades;
        }

        if (
            Array.isArray(
                payload?.open_trades
            )
        ) {
            return payload.open_trades;
        }

        if (Array.isArray(payload?.data)) {
            return payload.data;
        }

        return [];
    }

    async function refresh() {
        try {
            const response = await fetch(
                "/api/v1/trades/open",
                {
                    cache: "no-store",
                    headers: {
                        "Accept":
                            "application/json"
                    }
                }
            );

            if (!response.ok) {
                return;
            }

            const payload =
                await response.json();

            state.trades =
                extractTrades(payload);

            render();

        } catch (error) {
            console.error(
                "Dashboard Live-KPIs konnten "
                + "nicht aktualisiert werden:",
                error
            );
        }
    }

    function setupSwitcher(
        type,
        stateKey
    ) {
        document
            .querySelectorAll(
                '[data-kpi-switcher="'
                + type
                + '"] button[data-direction]'
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        state[stateKey] =
                            button.dataset.direction
                            || "ALL";

                        button
                            .parentElement
                            .querySelectorAll("button")
                            .forEach(
                                candidate =>
                                    candidate.classList.toggle(
                                        "active",
                                        candidate === button
                                    )
                            );

                        render();
                    }
                );
            });
    }

    document.addEventListener(
        "DOMContentLoaded",
        function () {
            setupSwitcher(
                "open",
                "openDirection"
            );

            setupSwitcher(
                "margin",
                "marginDirection"
            );

            refresh();

            window.setInterval(
                refresh,
                2000
            );
        }
    );

})();
</script>





