                            atlas-tpsl-v56-percent
                            ${signedClass(percent)}
                        "
                    >
                        ${formatSigned(percent, "%")}
                    </span>
                </div>
            `;
        }).join("");

        return `
            <section
                class="
                    atlas-tpsl-v56-card
                    atlas-tpsl-v56-card-${targetType}
                "
                data-target-kind="${escapeHtml(targetType)}"
                data-level-count="${String(levels.length)}"
            >
                <header class="atlas-tpsl-v56-header">
                    <span
                        class="atlas-tpsl-v56-spacer"
                        aria-hidden="true"
                    ></span>

                    <span class="atlas-tpsl-v56-count">
                        ${String(levels.length)} Level
                    </span>

                    <button
                        type="button"
                        class="
                            atlas-small-action
                            atlas-tpsl-v56-edit
                        "
                        data-action="edit-tpsl"
                        data-position-id="${positionId}"
                        data-target-type="${escapeHtml(targetType)}"
                        title="${escapeHtml(editTitle)}"
                        aria-label="${escapeHtml(editTitle)}"
                    >
                        ${icon("edit")}
                    </button>
                </header>

                <div
                    class="
                        atlas-tpsl-v56-levels
                        ${levels.length ? "" : "is-empty"}
                    "
                >
                    ${
                        levels.length
                            ? rows
                            : `
                                <span
                                    class="atlas-tpsl-v56-empty"
                                    aria-hidden="true"
                                >
                                    –
                                </span>
                            `
                    }
                </div>
            </section>
        `;
    }

    /*
     * PROJECT ATLAS M5.6 FINAL TPSL RENDERER END
     */


    function signalHtml(trade, external) {
        if (external) {
            return `
                <div class="atlas-signal-name">
                    Manueller Trade
                </div>

                <span class="atlas-manual-label">
                    MANUELL
                </span>
            `;
        }

        const name = (
            trade.signal_name
            ?? trade.signal_id
            ?? "Unbekanntes Signal"
        );

        return `
            <div
                class="atlas-signal-name"
                title="${escapeHtml(name)}"
            >
                ${escapeHtml(name)}
            </div>
        `;
    }

    function normalizeTradeTimeframe(value) {
        const raw = String(
            value ?? ""
        )
            .trim()
            .toUpperCase()
            .replace(/\s+/g, "");

        if (["D", "1D", "DAILY", "DAY"].includes(raw)) {
            return {
                key: "daily",
                label: "DAILY",
                rowClass: "atlas-timeframe-row-daily",
            };
        }

        if (["4H", "4HR", "4HOUR"].includes(raw)) {
            return {
                key: "4h",
                label: "4H",
                rowClass: "atlas-timeframe-row-4h",
            };
        }

        if (["2H", "2HR", "2HOUR"].includes(raw)) {
            return {
                key: "2h",
                label: "2H",
                rowClass: "atlas-timeframe-row-2h",
            };
        }

        if (["1H", "60M", "60MIN"].includes(raw)) {
            return {
                key: "1h",
                label: "1H",
                rowClass: "atlas-timeframe-row-1h",
            };
        }

        if (["30M", "30MIN"].includes(raw)) {
            return {
                key: "30m",
                label: "30M",
                rowClass: "atlas-timeframe-row-30m",
            };
        }

        if (["15M", "15MIN"].includes(raw)) {
            return {
                key: "15m",
                label: "15M",
                rowClass: "atlas-timeframe-row-15m",
            };
        }

        return {
            key: "neutral",
            label: raw || "–",
            rowClass: "",
        };
    }


    function timeframeHtml(trade) {
        const timeframe = normalizeTradeTimeframe(
            trade.timeframe
        );

        const iconSvg = (
            timeframe.key === "daily"
                ? `
                    <svg viewBox="0 0 24 24">
                        <rect
                            x="3"
                            y="5"
                            width="18"
                            height="16"
                            rx="2"
                        ></rect>
                        <path d="M16 3v4"></path>
                        <path d="M8 3v4"></path>
                        <path d="M3 10h18"></path>
                    </svg>
                `
                : `
                    <svg viewBox="0 0 24 24">
                        <circle
                            cx="12"
                            cy="12"
                            r="9"
                        ></circle>
                        <path d="M12 7v5l3 2"></path>
                    </svg>
                `
        );

        return `
            <span
                class="
                    atlas-timeframe-badge
                    atlas-timeframe-${timeframe.key}
                "
                title="Zeitintervall: ${
                    escapeHtml(timeframe.label)
                }"
            >
                <span class="atlas-timeframe-icon">
                    ${iconSvg}
                </span>

                <span>
                    ${escapeHtml(timeframe.label)}
                </span>
            </span>
        `;
    }


    function rowHtml(trade, external) {
        const values = tradeValues(trade);

        const positionId = String(
            trade.position_id ?? ""
        );

        const escapedId = escapeHtml(positionId);
        const direction = directionOf(trade);
        const locked = Boolean(trade.is_locked);
        const opened = openedParts(trade.opened_at);

        const timeframe = normalizeTradeTimeframe(
            trade.timeframe
        );

        const timeframeRowClass = (
            external
                ? ""
                : timeframe.rowClass
        );

        const firstCell = external
            ? `
                <td class="atlas-leading-column">
                    <span class="atlas-pin">
                        ${icon("pin")}
                    </span>
                </td>
            `
            : `
                <td class="atlas-leading-column">
                    <input
                        type="checkbox"
                        class="atlas-trade-checkbox"
                        data-position-id="${escapedId}"
                        ${
                            state.selected.has(positionId)
                                ? "checked"
                                : ""
                        }
                        ${locked ? "disabled" : ""}
                    >
                </td>
            `;

        return `
            <tr
                class="${timeframeRowClass}"
                data-position-id="${escapedId}"
                data-source="${escapeHtml(sourceOf(trade))}"
                data-timeframe="${escapeHtml(timeframe.label)}"
            >
                ${firstCell}

                <td class="atlas-signal-cell">
                    ${signalHtml(trade, external)}
                </td>

                <td>
                    ${escapeHtml(trade.symbol ?? "–")}
                </td>

                <td>
                    <span class="
                        atlas-direction
                        ${direction.toLowerCase()}
                    ">
                        ${escapeHtml(direction || "–")}
                    </span>
                </td>

                ${
                    external
                        ? ""
                        : `
                            <td>
                                ${timeframeHtml(trade)}
                            </td>
                        `
                }

                <td>
                    ${formatPrice(trade.entry_price)}
                </td>

                <td
                    data-live="pnl"
                    class="${signedClass(values.pnl)}"
                >
                    ${formatSigned(values.pnl)}
                </td>

                <td
                    data-live="roi"
                    class="${signedClass(values.roi)}"
                >
                    ${formatSigned(values.roi, "%")}
                </td>

                <td>
                    ${targetHtml(trade, "tp")}
                </td>

                <td>
                    ${targetHtml(trade, "sl")}
                </td>

                <td>
                    <div class="atlas-margin-cell">
                        <span data-live="margin">
                            ${formatNumber(values.margin)}
                        </span>

                        <button
                            type="button"
                            class="
                                atlas-small-action
                                atlas-margin-plus
                            "
                            data-action="margin-info"
                            data-position-id="${escapedId}"
                            title="Margin+"
                        >
                            ${icon("plus")}
                        </button>
                    </div>
                </td>

                <td>
                    ${
                        numberOrNull(
                            trade.leverage
                        ) === null
                            ? "–"
                            : escapeHtml(
                                trade.leverage
                            ) + "x"
                    }
                </td>

                <td>
                    <span class="atlas-status">
                        ${
                            String(
                                trade.status ?? "OPEN"
                            ).toUpperCase() === "OPEN"
                                ? "Aktiv"
                                : escapeHtml(trade.status)
                        }
                    </span>
                </td>

                <td>
                    <div class="atlas-opened">
                        <span>${escapeHtml(opened.date)}</span>
                        <small>${escapeHtml(opened.time)}</small>
                    </div>
                </td>

                <td>
                    <span
                        class="atlas-ref-duration"
                        data-opened-at="${
                            escapeHtml(
                                normalizedDate(
                                    trade.opened_at
                                )
                            )
                        }"
                    >
                        ${durationText(trade.opened_at)}
                    </span>
                </td>

                <td>
                    <button
                        type="button"
                        class="
                            atlas-row-action
                            atlas-lock-action
                            ${locked ? "locked" : "unlocked"}
                        "
                        data-action="toggle-lock"
                        data-position-id="${escapedId}"
                        title="${
                            locked
                                ? "Trade entsperren"
                                : "Trade sperren"
                        }"
                    >
                        ${
                            icon(
                                locked
                                    ? "lock"
                                    : "unlock"
                            )
                        }
                    </button>

                    <button
                        type="button"
                        class="
                            atlas-row-action
                            atlas-close-action
                        "
                        data-action="close-one"
                        data-position-id="${escapedId}"
                        title="Trade schließen"
                    >
                        ${icon("close")}
                    </button>
                </td>
            </tr>
        `;
    }

    function tableHtml(trades, external) {
        if (!trades.length) {
            return `
                <div class="atlas-empty">
                    ${
                        external
                            ? "Keine manuellen BitUnix-Trades vorhanden."
                            : "Keine automatischen Signal-Trades vorhanden."
                    }
                </div>
            `;
        }

        return `
            <div class="atlas-table-wrap">
                <table class="atlas-reference-table">
                    <thead>
