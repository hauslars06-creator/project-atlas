    function activateStatisticsPreset(
        preset
    ) {
        if (
            !preset
            || preset === "overview"
        ) {
            return;
        }

        const root = document.getElementById(
            "atlas-statistics-dashboard"
        );

        if (!root) {
            return;
        }

        const presetTokens = {
            day: [
                "1 tag",
                "tag",
                "tagesstatistik"
            ],
            week: [
                "7 tage",
                "woche",
                "wochenstatistik"
            ],
            month: [
                "30 tage",
                "monat",
                "monatsstatistik"
            ]
        };

        const tokens = (
            presetTokens[preset]
            || []
        );

        const buttons = Array.from(
            root.querySelectorAll(
                "button, [role='button']"
            )
        );

        const matchingButton = buttons.find(
            function (button) {
                const label = normalizeText(
                    button.textContent
                );

                return tokens.some(
                    function (token) {
                        return (
                            label === token
                            || label.includes(token)
                        );
                    }
                );
            }
        );

        if (
            matchingButton
            && !matchingButton.disabled
        ) {
            matchingButton.click();
        }
    }


