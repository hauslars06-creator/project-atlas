    function updateActiveSidebar(view) {
        const links = getSidebarLinks();

        for (const link of links) {
            link.classList.remove(
                "atlas-view-active"
            );

            link.removeAttribute(
                "aria-current"
            );
        }

        let targetLabel = null;

        if (view === "dashboard") {
            targetLabel = "dashboard";
        }

        if (view === "history") {
            targetLabel = "trade historie";
        }

        if (view === "signals") {
            targetLabel = (
                normalizeText(
                    window.location.hash
                )
                === "#atlas-signal-form"
                    ? "signale verwalten"
                    : "signale"
            );
        }

        if (view === "statistics") {
            targetLabel = "übersicht";
        }

        if (
            view === "signal-performance"
        ) {
            targetLabel = (
                "performance je signal"
            );
        }

        if (!targetLabel) {
            return;
        }

        const target = links.find(
            function (link) {
                return (
                    normalizeText(
                        link.textContent
                    )
                    === targetLabel
                );
            }
        );

        if (target) {
            target.classList.add(
                "atlas-view-active"
            );

            target.setAttribute(
                "aria-current",
                "page"
            );
        }
    }


    function resolveScrollTarget(view) {
        if (view === "history") {
            return document.getElementById(
                "atlas-trade-history"
            );
        }

        if (view === "signals") {
            return (
                document.getElementById(
                    "atlas-signal-form"
                )
                || document.getElementById(
                    "atlas-signals"
                )
            );
        }

        if (
            view === "signal-performance"
        ) {
            return (
                applySignalPerformanceFocus()
                || document.getElementById(
                    "atlas-statistics-dashboard"
                )
            );
        }

        if (view === "statistics") {
            clearSignalPerformanceFocus();

            return document.getElementById(
                "atlas-statistics-dashboard"
            );
        }

        clearSignalPerformanceFocus();

        const hash = String(
            window.location.hash || ""
        );

        if (hash) {
            try {
                const hashTarget = (
                    document.querySelector(
                        hash
                    )
                );

                if (hashTarget) {
                    return hashTarget;
                }
            } catch (error) {
                /*
                 * Ungültige Hash-Selektoren werden ignoriert.
                 */
            }
        }

        return document.getElementById(
            "atlas-reference-kpis"
        );
    }


    function applyView(
        options = {}
    ) {
        configureSidebarLinks();

        const view = resolveView();

        const wasHistory = (
            document.body.classList.contains(
                "atlas-view-history"
            )
        );

        if (
            wasHistory
            && view !== "history"
            && typeof window.atlasResetHistorySort
                === "function"
        ) {
            window.atlasResetHistorySort();
        }

        document.body.classList.remove(
            ...VIEW_CLASSES
        );

        document.body.classList.add(
            "atlas-view-" + view,
            "atlas-view-ready"
        );

        updateTopbar(view);
        updateActiveSidebar(view);
        schedulePinUpdate();

        const target = (
            resolveScrollTarget(view)
        );

        if (
            view === "statistics"
            && pendingStatisticsPreset
        ) {
            window.setTimeout(
                function () {
                    activateStatisticsPreset(
                        pendingStatisticsPreset
                    );

                    pendingStatisticsPreset = null;
                },
                80
            );
        }

        if (
            options.scroll === false
            || !target
        ) {
            return;
        }

        window.setTimeout(
            function () {
                target.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            },
            40
        );
    }


    document.addEventListener(
        "DOMContentLoaded",
        function () {
            configureSidebarLinks();

            applyView({
                scroll: false
            });

            const root = document.getElementById(
                "atlas-open-trades"
            );

            if (root) {
                const observer = (
                    new MutationObserver(
                        function () {
                            schedulePinUpdate();
                        }
                    )
                );

                observer.observe(
                    root,
                    {
                        childList: true,
                        subtree: true,
                        characterData: true
                    }
                );
            }

            window.setTimeout(
                schedulePinUpdate,
                150
            );

            window.setTimeout(
                schedulePinUpdate,
                700
            );
        }
    );


    window.addEventListener(
        "hashchange",
        function () {
            applyView({
                scroll: true
            });
        }
    );


    document.addEventListener(
        "click",
        function (event) {
            if (
                !(event.target instanceof Element)
            ) {
                return;
            }

            const link = event.target.closest(
                "#atlas-sidebar a, "
                + ".atlas-sidebar a, "
                + "aside a"
            );

            if (!link) {
                return;
            }

            if (
                link.dataset.atlasStatisticsPreset
            ) {
                pendingStatisticsPreset = (
                    link.dataset.atlasStatisticsPreset
                );
            }

            window.setTimeout(
                function () {
                    applyView({
                        scroll: true
                    });
                },
                0
            );
        }
    );
})();
</script>


