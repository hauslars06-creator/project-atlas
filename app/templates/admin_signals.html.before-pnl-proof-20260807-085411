<script id="atlas-trade-collapse-runtime">
(function(){

const ROOT_ID = "atlas-open-trades";

const STORAGE_KEYS = {
    external: "atlasDashboardExternalCollapsed",
    active: "atlasDashboardActiveCollapsed"
};


function getStoredState(type){

    return (
        localStorage.getItem(
            STORAGE_KEYS[type]
        ) === "1"
    );
}


function saveState(type, collapsed){

    localStorage.setItem(
        STORAGE_KEYS[type],
        collapsed ? "1" : "0"
    );
}


function makeToggle(type){

    const button =
        document.createElement("button");

    button.type = "button";
    button.className =
        "atlas-collapse-toggle";

    button.dataset.collapseType = type;

    button.setAttribute(
        "aria-label",
        type === "external"
            ? "Gesperrte Trades ein- oder ausklappen"
            : "Aktive Trades ein- oder ausklappen"
    );

    button.innerHTML =
        '<span class="atlas-collapse-chevron">⌄</span>';

    return button;
}


function wrapPanel(panel, type){

    if(
        !panel
        || panel.dataset.atlasCollapseReady === "1"
    ){
        return;
    }

    const header =
        panel.querySelector(
            ":scope > .atlas-panel-header"
        );

    if(!header){
        return;
    }

    panel.dataset.atlasCollapseReady = "1";
    panel.dataset.collapseType = type;

    panel.classList.add(
        "atlas-collapse-panel"
    );


    /*
     * Alles unterhalb des Headers in einen
     * einzigen einklappbaren Body verschieben.
     */
    const body =
        document.createElement("div");

    body.className =
        "atlas-collapse-body";

    const inner =
        document.createElement("div");

    inner.className =
        "atlas-collapse-body-inner";

    body.appendChild(inner);


    const children =
        Array.from(panel.children);

    children.forEach(function(child){

        if(
            child !== header
            && child !== body
        ){
            inner.appendChild(child);
        }
    });

    panel.appendChild(body);


    /*
     * Toggle einsetzen.
     */
    const toggle =
        makeToggle(type);

    /*
     * Aktive UND gesperrte Trades verwenden
     * denselben rechten Tool-Bereich.
     *
     * Dadurch sitzt der Ein-/Ausklapp-Button
     * auf exakt derselben horizontalen Position.
     */
    let tools =
        header.querySelector(
            ".atlas-panel-tools"
        );

    if(!tools){

        tools =
            document.createElement(
                "div"
            );

        tools.className =
            "atlas-panel-tools";

        header.appendChild(tools);
    }

    tools.appendChild(toggle);


    /*
     * Gespeicherten Zustand wiederherstellen.
     */
    const collapsed =
        getStoredState(type);

    panel.classList.toggle(
        "is-collapsed",
        collapsed
    );

    toggle.setAttribute(
        "aria-expanded",
        collapsed ? "false" : "true"
    );

    toggle.title =
        collapsed
            ? "Bereich ausklappen"
            : "Bereich einklappen";
}


function enhancePanels(){

    const root =
        document.getElementById(
            ROOT_ID
        );

    if(!root){
        return;
    }

    /*
     * Gesperrte / externe Trades
     */
    root
        .querySelectorAll(
            ".atlas-external-panel"
        )
        .forEach(function(panel){

            wrapPanel(
                panel,
                "external"
            );
        });


    /*
     * Automatisch eröffnete aktive Trades
     */
    root
        .querySelectorAll(
            ".atlas-trade-panel:not(.atlas-external-panel)"
        )
        .forEach(function(panel){

            wrapPanel(
                panel,
                "active"
            );
        });
}


function togglePanel(button){

    const panel =
        button.closest(
            ".atlas-collapse-panel"
        );

    if(!panel){
        return;
    }

    const type =
        panel.dataset.collapseType;

    const collapsed =
        !panel.classList.contains(
            "is-collapsed"
        );

    panel.classList.toggle(
        "is-collapsed",
        collapsed
    );

    button.setAttribute(
        "aria-expanded",
        collapsed ? "false" : "true"
    );

    button.title =
        collapsed
            ? "Bereich ausklappen"
            : "Bereich einklappen";

    saveState(
        type,
        collapsed
    );
}


function start(){

    const root =
        document.getElementById(
            ROOT_ID
        );

    if(!root){
        return;
    }


    /*
     * Event Delegation:
     * funktioniert auch nach jedem automatischen
     * Re-Render der Trade-Tabellen.
     */
    root.addEventListener(
        "click",
        function(event){

            const button =
                event.target.closest(
                    ".atlas-collapse-toggle"
                );

            if(!button){
                return;
            }

            event.preventDefault();
            event.stopPropagation();

            togglePanel(button);
        }
    );


    /*
     * Erste Darstellung.
     */
    enhancePanels();


    /*
     * Die Trade-Ansicht wird regelmäßig dynamisch
     * neu aufgebaut. Nach jedem Re-Render werden
     * die neuen Panels automatisch wieder erweitert.
     */
    let scheduled = false;

    const observer =
        new MutationObserver(
            function(){

                if(scheduled){
                    return;
                }

                scheduled = true;

                requestAnimationFrame(
                    function(){

                        scheduled = false;
                        enhancePanels();
                    }
                );
            }
        );

    observer.observe(
        root,
        {
            childList:true,
            subtree:true
        }
    );
}


if(document.readyState === "loading"){

    document.addEventListener(
        "DOMContentLoaded",
        start
    );

}else{

    start();
}

})();
</script>

