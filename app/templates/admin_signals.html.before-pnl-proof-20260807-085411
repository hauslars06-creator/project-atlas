<script id="atlas-trade-duration-script">
(function () {
    function formatTradeDuration(totalSeconds) {
        if (!Number.isFinite(totalSeconds) || totalSeconds < 0) {
            return "–";
        }

        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = Math.floor(totalSeconds % 60);

        if (days > 0) {
            return `${days}T ${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
        }

        return `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    }

    function updateTradeDurations() {
        const now = Date.now();

        document.querySelectorAll(".trade-duration").forEach(function (element) {
            const openedAt = element.dataset.openedAt;

            if (!openedAt) {
                element.textContent = "–";
                return;
            }

            const start = Date.parse(openedAt);

            if (Number.isNaN(start)) {
                element.textContent = "–";
                return;
            }

            element.textContent = formatTradeDuration(
                Math.floor((now - start) / 1000)
            );
        });
    }

    updateTradeDurations();
    window.setInterval(updateTradeDurations, 1000);
})();
</script>

<script id="project-atlas-history-duration">
document.addEventListener("DOMContentLoaded", function () {
    function parseAtlasDate(value) {
        if (!value) {
            return null;
        }

        const cleaned = value.trim();

        if (!cleaned) {
            return null;
        }

        const parsed = new Date(cleaned);

        if (Number.isNaN(parsed.getTime())) {
            return null;
        }

        return parsed;
    }

    function formatTradeDuration(totalSeconds) {
        if (
            !Number.isFinite(totalSeconds)
            || totalSeconds < 0
        ) {
            return "–";
        }

        const seconds = Math.floor(totalSeconds);

        const days = Math.floor(
            seconds / 86400
        );

        const hours = Math.floor(
            (seconds % 86400) / 3600
        );

        const minutes = Math.floor(
            (seconds % 3600) / 60
        );

        const remainingSeconds = (
            seconds % 60
        );

        const parts = [];

        if (days > 0) {
            parts.push(days + " T");
        }

        if (hours > 0 || days > 0) {
            parts.push(hours + " Std");
        }

        if (minutes > 0 || hours > 0 || days > 0) {
            parts.push(minutes + " Min");
        }

        if (parts.length === 0) {
            parts.push(
                remainingSeconds + " Sek"
            );
        }

        return parts.join(" ");
    }

    document
        .querySelectorAll(
            ".history-trade-duration"
        )
        .forEach(function (element) {
            const openedAt = parseAtlasDate(
                element.dataset.openedAt
            );

            const closedAt = parseAtlasDate(
                element.dataset.closedAt
            );

            if (!openedAt || !closedAt) {
                element.textContent = "–";
                return;
            }

            const durationSeconds = (
                closedAt.getTime()
                - openedAt.getTime()
            ) / 1000;

            element.textContent = (
                formatTradeDuration(
                    durationSeconds
                )
            );
        });
});
</script>


<script id="project-atlas-m46a-close-all">
document.addEventListener("DOMContentLoaded", function () {
    const button = document.getElementById(
        "atlas-close-all-unlocked"
    );

    const message = document.getElementById(
        "atlas-close-all-message"
    );

    if (!button || !message) {
        return;
    }

    function showMessage(type, text) {
        message.className = (
            "atlas-action-message " + type
        );

        message.textContent = text;
    }

    button.addEventListener("click", async function () {
        const confirmed = window.confirm(
            "Sollen wirklich alle aktuell entsperrten "
            + "offenen Trades geschlossen werden?\n\n"
            + "Gesperrte Trades werden nicht geschlossen."
        );

        if (!confirmed) {
            return;
        }

        const originalText = button.textContent.trim();

        button.disabled = true;
        button.textContent = "Trades werden geschlossen …";

        message.className = "atlas-action-message";
        message.textContent = "";

        try {
            const response = await fetch(
                "/api/v1/trades/close-all?confirm=true",
                {
                    method: "POST",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            let payload = null;

            try {
                payload = await response.json();
            } catch (jsonError) {
                payload = null;
            }

            if (!response.ok) {
                let errorMessage = (
                    "Die entsperrten Trades konnten "
                    + "nicht geschlossen werden."
                );

                if (
                    payload
                    && typeof payload.detail === "string"
                ) {
                    errorMessage = payload.detail;
                } else if (
                    payload
                    && typeof payload.message === "string"
                ) {
                    errorMessage = payload.message;
                }

                throw new Error(errorMessage);
            }

            let successMessage = (
                "Close-all-Auftrag wurde erfolgreich ausgeführt."
            );

            if (
                payload
                && typeof payload.message === "string"
            ) {
                successMessage = payload.message;
            }

            showMessage("success", successMessage);

            window.setTimeout(function () {
                if (
                    typeof window.atlasRefreshOpenTrades
                    === "function"
                ) {
                    window.atlasRefreshOpenTrades(true);
                }
            }, 500);

            button.disabled = false;
            button.textContent = originalText;
        } catch (error) {
            console.error(
                "Project Atlas Close-all fehlgeschlagen:",
                error
            );

            showMessage(
                "error",
                error instanceof Error
                    ? error.message
                    : "Unbekannter Fehler beim Schließen der Trades."
            );

            button.disabled = false;
            button.textContent = originalText;
        }
    });
});
</script>


<script id="project-atlas-m46b-trade-lock">
document.addEventListener("DOMContentLoaded", function () {
    const message = document.getElementById(
        "atlas-lock-message"
    );

    function showMessage(type, text) {
        if (!message) {
            return;
        }

        message.className = (
            "atlas-action-message " + type
        );

        message.textContent = text;
    }

    function updateButton(button, isLocked) {
        button.dataset.locked = (
            isLocked ? "true" : "false"
        );

        button.setAttribute(
            "aria-pressed",
            isLocked ? "true" : "false"
        );

        button.classList.toggle(
            "locked",
            isLocked
        );

        button.classList.toggle(
            "unlocked",
            !isLocked
        );

        const icon = button.querySelector(
            ".atlas-lock-icon"
        );

        const label = button.querySelector(
            ".atlas-lock-label"
        );

        if (icon) {
            icon.textContent = (
                isLocked ? "🔒" : "🔓"
            );
        }

        if (label) {
            label.textContent = (
                isLocked ? "Gesperrt" : "Entsperrt"
            );
        }

        button.title = (
            isLocked
                ? "Trade entsperren"
                : "Trade sperren"
        );
    }

    document
        .querySelectorAll(".atlas-lock-toggle")
        .forEach(function (button) {
            button.addEventListener(
                "click",
                async function () {
                    const positionId = (
                        button.dataset.positionId || ""
                    ).trim();

                    const currentlyLocked = (
                        button.dataset.locked === "true"
                    );

                    if (!positionId) {
                        showMessage(
                            "error",
                            "Dieser Trade besitzt keine "
                            + "gültige Positions-ID."
                        );
                        return;
                    }

                    const action = (
                        currentlyLocked
                            ? "unlock"
                            : "lock"
                    );

                    const confirmationText = (
                        currentlyLocked
                            ? "Diesen Trade wirklich entsperren?"
                            : "Diesen Trade wirklich sperren? "
                              + "Er wird dann von „Alle "
                              + "entsperrten schließen“ "
                              + "ausgeschlossen."
                    );

                    if (!window.confirm(confirmationText)) {
                        return;
                    }

                    button.disabled = true;

                    const label = button.querySelector(
                        ".atlas-lock-label"
                    );

                    if (label) {
                        label.textContent = (
                            currentlyLocked
                                ? "Entsperren …"
                                : "Sperren …"
                        );
                    }

                    if (message) {
                        message.className = (
                            "atlas-action-message"
                        );
                        message.textContent = "";
                    }

                    try {
                        const response = await fetch(
                            "/api/v1/trades/"
                            + encodeURIComponent(positionId)
                            + "/"
                            + action,
                            {
                                method: "POST",
                                headers: {
                                    "Accept": "application/json"
                                }
                            }
                        );

                        let payload = null;

                        try {
                            payload = await response.json();
                        } catch (jsonError) {
                            payload = null;
                        }

                        if (!response.ok) {
                            let errorText = (
                                "Der Sperrstatus konnte "
                                + "nicht geändert werden."
                            );

                            if (
                                payload
                                && typeof payload.detail
                                    === "string"
                            ) {
                                errorText = payload.detail;
                            } else if (
                                payload
                                && typeof payload.message
                                    === "string"
                            ) {
                                errorText = payload.message;
                            }

                            throw new Error(errorText);
                        }

                        const newState = !currentlyLocked;

                        updateButton(
                            button,
                            newState
                        );

                        showMessage(
                            "success",
                            newState
                                ? "Trade wurde erfolgreich gesperrt."
                                : "Trade wurde erfolgreich entsperrt."
                        );

                        button.disabled = false;
                        button.blur();
                    } catch (error) {
                        console.error(
                            "Project Atlas Lock-Aktion fehlgeschlagen:",
                            error
                        );

                        updateButton(
                            button,
                            currentlyLocked
                        );

                        showMessage(
                            "error",
                            error instanceof Error
                                ? error.message
                                : "Unbekannter Fehler beim "
                                  + "Ändern des Sperrstatus."
                        );

                        button.disabled = false;
                    }
                }
            );
        });
});
</script>


<script id="project-atlas-m52a-statistics">
document.addEventListener("DOMContentLoaded", function () {
    const dashboard = document.getElementById(
        "atlas-statistics-dashboard"
    );

    if (!dashboard) {
        return;
    }

    const periodButtons = Array.from(
        document.querySelectorAll(
            ".atlas-period-button"
        )
    );

    const elements = {
        pnl: document.getElementById(
            "atlas-kpi-pnl"
        ),
        periodLabel: document.getElementById(
            "atlas-kpi-period-label"
        ),
        winRate: document.getElementById(
            "atlas-kpi-win-rate"
        ),
        winLoss: document.getElementById(
            "atlas-kpi-win-loss"
        ),
        evaluated: document.getElementById(
            "atlas-kpi-evaluated"
        ),
        totalTrades: document.getElementById(
            "atlas-kpi-total-trades"
        ),
        profitFactor: document.getElementById(
            "atlas-stat-profit-factor"
        ),
        averageWin: document.getElementById(
            "atlas-stat-average-win"
        ),
        averageLoss: document.getElementById(
            "atlas-stat-average-loss"
        ),
        winStreak: document.getElementById(
            "atlas-stat-win-streak"
        ),
        lossStreak: document.getElementById(
            "atlas-stat-loss-streak"
        ),
        missing: document.getElementById(
            "atlas-stat-missing"
        ),
        message: document.getElementById(
            "atlas-statistics-message"
        ),
        signalBody: document.getElementById(
            "atlas-signal-performance-body"
        )
    };

    const numberFormatter = new Intl.NumberFormat(
        "de-DE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

    const compactNumberFormatter = (
        new Intl.NumberFormat(
            "de-DE",
            {
                maximumFractionDigits: 2
            }
        )
    );

    function formatNumber(value) {
        if (
            value === null
            || value === undefined
            || Number.isNaN(Number(value))
        ) {
            return "–";
        }

        return numberFormatter.format(
            Number(value)
        );
    }

    function formatPercent(value) {
        if (
            value === null
            || value === undefined
            || Number.isNaN(Number(value))
        ) {
            return "–";
        }

        return formatNumber(value) + " %";
    }

    function formatUsdt(value) {
        if (
            value === null
            || value === undefined
            || Number.isNaN(Number(value))
        ) {
            return "–";
        }

        const numericValue = Number(value);
        const prefix = numericValue > 0 ? "+" : "";

        return (
            prefix
            + formatNumber(numericValue)
            + " USDT"
        );
    }

    function valueClass(value) {
        const numericValue = Number(value);

        if (numericValue > 0) {
            return "atlas-stat-positive";
        }

        if (numericValue < 0) {
            return "atlas-stat-negative";
        }

        return "atlas-stat-neutral";
    }

    function setKpiValueClass(
        element,
        value
    ) {
        if (!element) {
            return;
        }

        element.classList.remove(
            "positive",
            "negative",
            "neutral"
        );

        const numericValue = Number(value);

        if (numericValue > 0) {
            element.classList.add("positive");
        } else if (numericValue < 0) {
            element.classList.add("negative");
        } else {
            element.classList.add("neutral");
        }
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function renderSignals(signals) {
        if (!elements.signalBody) {
            return;
        }

        if (!Array.isArray(signals) || signals.length === 0) {
            elements.signalBody.innerHTML = `
                <tr>
                    <td colspan="8">
                        Für diesen Zeitraum liegen keine
                        Signal-Trades vor.
                    </td>
                </tr>
            `;

            return;
        }

        elements.signalBody.innerHTML = signals
            .map(function (signal) {
                const pnl = signal.net_pnl_usdt;

                return `
                    <tr>
                        <td>
                            <span class="atlas-performance-name">
                                ${escapeHtml(signal.signal_name)}
                            </span>

                            <span class="atlas-performance-id">
                                ${escapeHtml(signal.signal_id)}
                            </span>
                        </td>

                        <td>
                            ${signal.trade_count}
                        </td>

                        <td>
                            ${signal.evaluated_trade_count}
                        </td>

                        <td class="atlas-stat-positive">
                            ${signal.winning_trades}
                        </td>

                        <td class="atlas-stat-negative">
                            ${signal.losing_trades}
                        </td>

                        <td>
                            ${formatPercent(
                                signal.win_rate_percent
                            )}
                        </td>

                        <td class="${valueClass(pnl)}">
                            ${formatUsdt(pnl)}
                        </td>

                        <td class="${
                            valueClass(
                                signal.average_roi_percent
                            )
                        }">
                            ${formatPercent(
                                signal.average_roi_percent
                            )}
                        </td>
                    </tr>
                `;
            })
            .join("");
    }

    function showError(text) {
        if (!elements.message) {
            return;
        }

        elements.message.className = (
            "atlas-statistics-message error"
        );

        elements.message.textContent = text;
    }

    function clearError() {
        if (!elements.message) {
            return;
        }

        elements.message.className = (
            "atlas-statistics-message"
        );

        elements.message.textContent = "";
    }

    async function loadStatistics(period) {
        clearError();

        try {
            const response = await fetch(
                "/api/v1/statistics/summary"
                + "?period="
                + encodeURIComponent(period),
                {
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            let payload = null;

            try {
                payload = await response.json();
            } catch (jsonError) {
                payload = null;
            }

            if (!response.ok || !payload?.success) {
                throw new Error(
                    payload?.detail
                    || "Statistik konnte nicht geladen werden."
                );
            }

            const summary = payload.summary || {};
            const periodData = payload.period || {};

            elements.pnl.textContent = formatUsdt(
                summary.net_pnl_usdt
            );

            setKpiValueClass(
                elements.pnl,
                summary.net_pnl_usdt
            );

            elements.periodLabel.textContent = (
                periodData.label || "Ausgewählter Zeitraum"
            );

            elements.winRate.textContent = formatPercent(
                summary.win_rate_percent
            );

            elements.winLoss.textContent = (
                String(summary.winning_trades ?? 0)
                + " Gewinner / "
                + String(summary.losing_trades ?? 0)
                + " Verlierer"
            );

            elements.evaluated.textContent = (
                compactNumberFormatter.format(
                    summary.evaluated_trade_count ?? 0
                )
            );

            elements.totalTrades.textContent = (
                "von "
                + compactNumberFormatter.format(
                    summary.trade_count ?? 0
                )
                + " Trades"
            );

            elements.profitFactor.textContent = (
                summary.profit_factor === "infinity"
                    ? "∞"
                    : formatNumber(
                        summary.profit_factor
                    )
            );

            elements.averageWin.textContent = formatUsdt(
                summary.average_win_usdt
            );

            elements.averageLoss.textContent = formatUsdt(
                summary.average_loss_usdt
            );

            elements.winStreak.textContent = (
                compactNumberFormatter.format(
                    summary.best_win_streak ?? 0
                )
            );

            elements.lossStreak.textContent = (
                compactNumberFormatter.format(
                    summary.worst_loss_streak ?? 0
                )
            );

            elements.missing.textContent = (
                compactNumberFormatter.format(
                    summary.missing_result_count ?? 0
                )
            );

            renderSignals(
                payload.performance_by_signal || []
            );
        } catch (error) {
            console.error(
                "Project Atlas Statistikfehler:",
                error
            );

            showError(
                error instanceof Error
                    ? error.message
                    : "Unbekannter Statistikfehler."
            );
        }
    }

    periodButtons.forEach(function (button) {
        button.addEventListener(
            "click",
            function () {
                periodButtons.forEach(
                    function (candidate) {
                        candidate.classList.remove(
                            "active"
                        );
                    }
                );

                button.classList.add("active");

                loadStatistics(
                    button.dataset.period
                    || "last_30_days"
                );
            }
        );
    });

    loadStatistics("last_30_days");

    window.setInterval(
        function () {
            const activeButton = (
                document.querySelector(
                    ".atlas-period-button.active"
                )
            );

            loadStatistics(
                activeButton?.dataset.period
                || "last_30_days"
            );
        },
        30000
    );
});
</script>


<script id="project-atlas-clean-dark-upgrade">
document.addEventListener("DOMContentLoaded", function () {
    const elements = {
        pnl: document.getElementById(
            "atlas-reference-pnl"
        ),
        roi: document.getElementById(
            "atlas-reference-roi"
        ),
        winRate: document.getElementById(
            "atlas-reference-winrate"
        ),
        winLoss: document.getElementById(
            "atlas-reference-winloss"
        ),
        balance: document.getElementById(
            "atlas-reference-balance"
        ),
        available: document.getElementById(
            "atlas-reference-available"
        )
    };

    const formatter = new Intl.NumberFormat(
        "de-DE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

    function formatNumber(value) {
        if (
            value === null
            || value === undefined
            || value === ""
        ) {
            return "–";
        }

        const number = Number(value);

        if (!Number.isFinite(number)) {
            return "–";
        }

        return formatter.format(number);
    }

    function signedText(value, suffix = "") {
        const number = Number(value);

        if (!Number.isFinite(number)) {
            return "–";
        }

        const prefix = number > 0 ? "+" : "";

        return (
            prefix
            + formatNumber(number)
            + suffix
        );
    }

    function setSignedClass(element, value) {
        if (!element) {
            return;
        }

        element.classList.remove(
            "positive",
            "negative"
        );

        const number = Number(value);

        if (number > 0) {
            element.classList.add("positive");
        } else if (number < 0) {
            element.classList.add("negative");
        }
    }

    function findNumber(source, names) {
        if (
            source === null
            || source === undefined
        ) {
            return null;
        }

        if (Array.isArray(source)) {
            for (const item of source) {
                const result = findNumber(
                    item,
                    names
                );

                if (result !== null) {
                    return result;
                }
            }

            return null;
        }

        if (typeof source !== "object") {
            return null;
        }

        const normalized = names.map(
            name => name.toLowerCase()
        );

        for (const [key, value] of Object.entries(source)) {
            if (
                normalized.includes(
                    key.toLowerCase()
                )
            ) {
                const number = Number(value);

                if (Number.isFinite(number)) {
                    return number;
                }
            }
        }

        for (const value of Object.values(source)) {
            const result = findNumber(
                value,
                names
            );

            if (result !== null) {
                return result;
            }
        }

        return null;
    }

    const dashboardKpiState = {
        pnlPeriod: "last_30_days",
        winratePeriod: "last_30_days",
    };

    /*
     * Verhindert Race Conditions:
     * Nur der jeweils neueste Statistik-Request
     * darf die Dashboard-Werte aktualisieren.
     */
    let referenceStatisticsRequestId = 0;

    function statisticsPeriodLabel(period) {
        const labels = {
            last_7_days: "Letzte 7 Tage",
            last_14_days: "Letzte 14 Tage",
            last_30_days: "Letzte 30 Tage",
            all: "Gesamt",
        };

        return labels[period] || period;
    }

    async function fetchReferenceStatistics(period) {
        const response = await fetch(
            "/api/v1/statistics/summary"
            + "?period="
            + encodeURIComponent(period),
            {
                cache: "no-store",
                headers: {
                    "Accept": "application/json"
                }
            }
        );

        const payload = await response.json();

        if (!response.ok || !payload?.success) {
            throw new Error(
                payload?.detail
                || "Statistik nicht verfügbar."
            );
        }

        return payload;
    }

    async function loadReferenceStatistics() {
        const requestId =
            ++referenceStatisticsRequestId;

        /*
         * Auswahl genau für diesen Request einfrieren.
         */
        const requestedPnlPeriod =
            dashboardKpiState.pnlPeriod;

        const requestedWinratePeriod =
            dashboardKpiState.winratePeriod;

        try {
            const periods = Array.from(
                new Set([
                    requestedPnlPeriod,
                    requestedWinratePeriod,
                ])
            );

            const results = await Promise.all(
                periods.map(
                    period =>
                        fetchReferenceStatistics(period)
                )
            );

            /*
             * Ein neuerer Klick / Auto-Refresh
             * hat inzwischen einen neuen Request
             * gestartet.
             *
             * Diese Antwort ist veraltet und
             * darf die Anzeige NICHT überschreiben.
             */
            if (
                requestId
                !== referenceStatisticsRequestId
            ) {
                return;
            }

            const payloadByPeriod = new Map();

            periods.forEach(
                function (period, index) {
                    payloadByPeriod.set(
                        period,
                        results[index]
                    );
                }
            );

            const pnlPayload =
                payloadByPeriod.get(
                    requestedPnlPeriod
                );

            const winPayload =
                payloadByPeriod.get(
                    requestedWinratePeriod
                );

            const pnlSummary =
                pnlPayload?.summary || {};

            const winSummary =
                winPayload?.summary || {};

            if (elements.pnl) {
                elements.pnl.textContent =
                    signedText(
                        pnlSummary.net_pnl_usdt
                    );

                setSignedClass(
                    elements.pnl,
                    pnlSummary.net_pnl_usdt
                );
            }

            if (elements.roi) {
                elements.roi.textContent =
                    signedText(
                        pnlSummary.average_roi_percent,
                        "% Ø ROI"
                    );

                setSignedClass(
                    elements.roi,
                    pnlSummary.average_roi_percent
                );
            }

            const pnlLabel =
                document.getElementById(
                    "atlas-pnl-period-label"
                );

            if (pnlLabel) {
                pnlLabel.textContent =
                    statisticsPeriodLabel(
                        requestedPnlPeriod
                    );
            }

            if (elements.winRate) {
                const value =
                    winSummary.win_rate_percent;

                elements.winRate.textContent = (
                    value === null
                    || value === undefined
                        ? "–"
                        : formatNumber(value) + "%"
                );
            }

            if (elements.winLoss) {
                elements.winLoss.textContent = (
                    String(
                        winSummary.winning_trades
                        ?? 0
                    )
                    + " Gewinne / "
                    + String(
                        winSummary.losing_trades
                        ?? 0
                    )
                    + " Verluste"
                );
            }

            const winLabel =
                document.getElementById(
                    "atlas-winrate-period-label"
                );

            if (winLabel) {
                winLabel.textContent =
                    statisticsPeriodLabel(
                        requestedWinratePeriod
                    );
            }

        } catch (error) {
            console.error(
                "Referenz-KPIs konnten nicht geladen werden:",
                error
            );
        }
    }

    function setupReferenceKpiSwitchers() {

        document
            .querySelectorAll(
                '[data-kpi-switcher="pnl"] '
                + "button[data-period]"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        dashboardKpiState.pnlPeriod =
                            button.dataset.period
                            || "last_30_days";

                        button
                            .parentElement
                            .querySelectorAll("button")
                            .forEach(
                                candidate =>
                                    candidate.classList.toggle(
                                        "active",
                                        candidate === button
                                    )
                            );

                        loadReferenceStatistics();
                    }
                );
            });


        document
            .querySelectorAll(
                '[data-kpi-switcher="winrate"] '
                + "button[data-period]"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        dashboardKpiState.winratePeriod =
                            button.dataset.period
                            || "last_30_days";

                        button
                            .parentElement
                            .querySelectorAll("button")
                            .forEach(
                                candidate =>
                                    candidate.classList.toggle(
                                        "active",
                                        candidate === button
                                    )
                            );

                        loadReferenceStatistics();
                    }
                );
            });
    }


    async function loadAccount() {
        try {
            const response = await fetch(
                "/bitunix/account",
                {
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            const payload = await response.json();

            if (!response.ok) {
                throw new Error(
                    "Accountdaten nicht verfügbar."
                );
            }

            /*
             * PROJECT ATLAS M5.3D1 ACCOUNT FIX
             *
             * Die aktuelle BitUnix-Antwort enthält kein
             * allgemeines Feld namens "balance".
             *
             * Dashboard Equity:
             * available
             * + margin
             * + crossUnrealizedPNL
             * + isolationUnrealizedPNL
             */
            const accountData = (
                payload
                && typeof payload.data === "object"
                && payload.data !== null
                    ? payload.data
                    : payload
            );

            function directAccountNumber(value) {
                if (
                    value === null
                    || value === undefined
                    || value === ""
                ) {
                    return null;
                }

                const number = Number(value);

                return Number.isFinite(number)
                    ? number
                    : null;
            }

            const available = directAccountNumber(
                accountData?.available
            );

            const usedMargin = directAccountNumber(
                accountData?.margin
            );

            const crossUnrealized = (
                directAccountNumber(
                    accountData?.crossUnrealizedPNL
                )
                ?? 0
            );

            const isolationUnrealized = (
                directAccountNumber(
                    accountData?.isolationUnrealizedPNL
                )
                ?? 0
            );

            let balance = null;

            if (
                available !== null
                && usedMargin !== null
            ) {
                balance = (
                    available
                    + usedMargin
                    + crossUnrealized
                    + isolationUnrealized
                );
            } else {
                /*
                 * Kompatibilitäts-Fallback für eine später
                 * möglicherweise geänderte API-Struktur.
                 */
                balance = findNumber(
                    payload,
                    [
                        "totalBalance",
                        "accountBalance",
                        "equity",
                        "totalEquity",
                        "marginBalance"
                    ]
                );
            }

            if (elements.balance) {
                elements.balance.textContent = (
                    formatNumber(balance)
                );
            }

            if (elements.available) {
                elements.available.textContent = (
                    "Verfügbar: "
                    + formatNumber(available)
                );
            }

            const usageElement =
                document.getElementById(
                    "atlas-reference-margin-usage"
                );

            if (usageElement) {
                let usage = null;

                if (
                    balance !== null
                    && balance > 0
                    && usedMargin !== null
                ) {
                    usage = (
                        usedMargin
                        / balance
                        * 100
                    );
                }

                usageElement.textContent = (
                    "Margin-Auslastung: "
                    + (
                        usage === null
                            ? "–"
                            : formatNumber(usage) + "%"
                    )
                );
            }
        } catch (error) {
            console.error(
                "Account Balance konnte nicht geladen werden:",
                error
            );

            if (elements.balance) {
                elements.balance.textContent = "–";
            }

            if (elements.available) {
                elements.available.textContent = (
                    "Verfügbar: –"
                );
            }
        }
    }

    function enableNavigation() {
        const links = Array.from(
            document.querySelectorAll(
                ".atlas-nav-link"
            )
        );

        links.forEach(function (link) {
            link.addEventListener(
                "click",
                function () {
                    links.forEach(
                        candidate => candidate.classList.remove(
                            "active"
                        )
                    );

                    link.classList.add("active");
                }
            );
        });
    }

    setupReferenceKpiSwitchers();
    loadReferenceStatistics();
    loadAccount();
    enableNavigation();

    window.setInterval(
        function () {
            loadReferenceStatistics();
            loadAccount();
        },
        10000
    );
});
</script>



<script id="project-atlas-m53c-reference-trades-v2">
(function () {
    "use strict";

    const REFRESH_MS = 2000;

    const state = {
        requestRunning: false,
        structureSignature: "",
        trades: new Map(),
        selected: new Set()
    };

    const numberFormatter = new Intl.NumberFormat(
        "de-DE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

    const priceFormatter = new Intl.NumberFormat(
        "de-DE",
        {
            minimumFractionDigits: 0,
            maximumFractionDigits: 8
        }
    );

    const ICONS = {
        pin: '<svg viewBox="0 0 24 24"><path d="M14 4l6 6-2 2-2-1-4 4v4l-2 2v-6l-4-4-2 1-2-2 6-6-1-3 2-2 5 5z"/></svg>',
        signal: '<svg viewBox="0 0 24 24"><path d="M4 17l5-5 3 3 7-8 1.5 1.3-8.5 9.7-3-3-3.5 3.5L4 17z"/><path d="M15 7h5v5h-2V9h-3V7z"/></svg>',
        edit: '<svg viewBox="0 0 24 24"><path d="M4 16.5V20h3.5L18 9.5 14.5 6 4 16.5zm16.7-9.8a1 1 0 000-1.4l-2-2a1 1 0 00-1.4 0l-1.6 1.6 3.5 3.5 1.5-1.7z"/></svg>',
        plus: '<svg viewBox="0 0 24 24"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/></svg>',
        refresh: '<svg viewBox="0 0 24 24"><path d="M17.7 6.3A8 8 0 104 12h2a6 6 0 116 6c-2.2 0-4.2-1.2-5.2-3H10v-2H3v7h2v-3.2A8 8 0 1019.1 5L22 8V2h-6l1.7 1.7z"/></svg>',
        lock: '<svg viewBox="0 0 24 24"><path d="M17 8h-1V6a4 4 0 00-8 0v2H7a2 2 0 00-2 2v10h14V10a2 2 0 00-2-2zm-7-2a2 2 0 114 0v2h-4V6zm3 9.7V18h-2v-2.3a2 2 0 112 0z"/></svg>',
        unlock: '<svg viewBox="0 0 24 24"><path d="M17 8h-7V6a2 2 0 013.8-.9l1.8-.9A4 4 0 008 6v2H7a2 2 0 00-2 2v10h14V10a2 2 0 00-2-2zm-4 7.7V18h-2v-2.3a2 2 0 112 0z"/></svg>',
        close: '<svg viewBox="0 0 24 24"><path d="M6.4 5L5 6.4l5.6 5.6L5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6 6.4 5z"/></svg>'
    };

    function icon(name) {
        return ICONS[name] || "";
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function numberOrNull(value) {
        if (
            value === null
            || value === undefined
            || value === ""
        ) {
            return null;
        }

        const number = Number(value);

        return Number.isFinite(number)
            ? number
            : null;
    }

    function firstValue(source, names) {
        for (const name of names) {
            if (
                source[name] !== null
                && source[name] !== undefined
            ) {
                return source[name];
            }
        }

        return null;
    }

    function tradeValues(trade) {
        return {
            pnl: firstValue(
                trade,
                [
                    "unrealized_pnl",
                    "pnl_usdt",
                    "pnl"
                ]
            ),
            roi: firstValue(
                trade,
                [
                    "pnl_percent",
                    "roi_percent",
                    "roi"
                ]
            ),
            margin: firstValue(
                trade,
                [
                    "current_margin",
                    "margin_usdt",
                    "margin"
                ]
            )
        };
    }

    function formatNumber(value) {
        const number = numberOrNull(value);

        return number === null
            ? "–"
            : numberFormatter.format(number);
    }

    function formatPrice(value) {
        const number = numberOrNull(value);

        return number === null
            ? "–"
            : priceFormatter.format(number);
    }

    function formatSigned(value, suffix = "") {
        const number = numberOrNull(value);

        if (number === null) {
            return "–";
        }

        return (
            (number > 0 ? "+" : "")
            + numberFormatter.format(number)
            + suffix
        );
    }

    function formatCloseReason(value) {

        const reason = String(
            value || ""
        )
        .trim()
        .toUpperCase();

        const labels = {
            "TAKE_PROFIT":
                "Take Profit",

            "STOP_LOSS":
                "Stop Loss",

            "MANUAL_CLOSE":
                "Manuell geschlossen",

            "FLASH_CLOSE":
                "Flash Close",

            "EMERGENCY_CLOSE":
                "Emergency Close",

            "BITUNIX_POSITION_CLOSED":
                "BitUnix / extern geschlossen",

            "UNKNOWN":
                "Unbekannt",
        };

        return (
            labels[reason]
            || String(value || "–")
        );
    }

    function signedClass(value) {
        const number = numberOrNull(value);

        if (number === null || number === 0) {
            return "neutral";
        }

        return number > 0
            ? "positive"
            : "negative";
    }

    function sourceOf(trade) {
        return String(
            trade.trade_source ?? "ATLAS"
        ).trim().toUpperCase();
    }

    function isExternal(trade) {
        return sourceOf(trade) === "EXTERNAL";
    }

    function directionOf(trade) {
        return String(
            trade.direction ?? ""
        ).trim().toUpperCase();
    }

    function normalizedDate(value) {
        if (!value) {
            return "";
        }

        const text = String(value);

        if (
            text.endsWith("Z")
            || /[+-]\d\d:\d\d$/.test(text)
        ) {
            return text;
        }

        return text + "Z";
    }

    function openedParts(value) {
        const normalized = normalizedDate(value);
        const date = normalized
            ? new Date(normalized)
            : null;

        if (
            !date
            || Number.isNaN(date.getTime())
        ) {
            return {
                date: "–",
                time: "–"
            };
        }

        return {
            date: new Intl.DateTimeFormat(
                "de-DE",
                {
                    day: "2-digit",
                    month: "2-digit"
                }
            ).format(date),

            time: new Intl.DateTimeFormat(
                "de-DE",
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            ).format(date)
        };
    }

    function durationText(value) {
        const normalized = normalizedDate(value);
        const opened = Date.parse(normalized);

        if (Number.isNaN(opened)) {
            return "–";
        }

        const seconds = Math.max(
            0,
            Math.floor(
                (Date.now() - opened) / 1000
            )
        );

        const days = Math.floor(seconds / 86400);
        const hours = Math.floor(
            (seconds % 86400) / 3600
        );
        const minutes = Math.floor(
            (seconds % 3600) / 60
        );

        if (days > 0) {
            return (
                days
                + "T "
                + hours
                + "h "
                + minutes
                + "m"
            );
        }

        if (hours > 0) {
            return hours + "h " + minutes + "m";
        }

        return minutes + "m";
    }

    function targetPercent(trade, price) {
        const entry = numberOrNull(
            trade.entry_price
        );

        const target = numberOrNull(price);

        if (
            entry === null
            || entry <= 0
            || target === null
            || target <= 0
        ) {
            return null;
        }

        if (directionOf(trade) === "SHORT") {
            return (
                (entry - target)
                / entry
                * 100
            );
        }

        return (
            (target - entry)
            / entry
            * 100
        );
    }

    function normalizedTpSlLevels(trade, type) {
        const source = type === "tp" ? trade.tp_levels : trade.sl_levels;

        if (Array.isArray(source) && source.length) {
            return source.filter(function (level) {
                return numberOrNull(level?.price) > 0;
            });
        }

        const legacyPrice = type === "tp" ? trade.tp_price : trade.sl_price;
        if (numberOrNull(legacyPrice) > 0) {
            return [{
                level: 1,
                order_id: null,
                price: legacyPrice,
                quantity: null,
                stop_type: null,
                order_type: null,
                order_price: null
            }];
        }

        return [];
    }

    function formatTpSlQuantity(quantity) {
        const parsed = numberOrNull(quantity);
        if (parsed === null || parsed <= 0) {
            return "";
        }

        return parsed.toLocaleString("de-DE", {
            minimumFractionDigits: 0,
            maximumFractionDigits: 8
        });
    }

    /*
     * =====================================================
     * PROJECT ATLAS M5.5C TPSL RENDERER START
     * =====================================================
     */

    /*
