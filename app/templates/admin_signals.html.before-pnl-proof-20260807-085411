    function staticSignature(trades) {
        return JSON.stringify(
            trades.map(
                function (trade) {
                    return [
                        trade.position_id,
                        trade.trade_source,
                        trade.signal_id,
                        trade.signal_name,
                        trade.symbol,
                        trade.direction,
                        trade.entry_price,
                        trade.tp_price,
                        trade.sl_price,
                        trade.leverage,
                        trade.status,
                        trade.opened_at,
                        Boolean(trade.is_locked)
                    ];
                }
            )
        );
    }

