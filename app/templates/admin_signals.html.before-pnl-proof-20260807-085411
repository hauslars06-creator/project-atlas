    function markManualTradeHeading() {
        const root = document.getElementById(
            "atlas-open-trades"
        );

        const manualTable = (
            findManualTradeTable()
        );

        if (
            !root
            || !manualTable
        ) {
            return;
        }

        const manualRows = Array.from(
            manualTable.querySelectorAll(
                "tbody tr"
            )
        ).filter(
            function (row) {
                return normalizeText(
                    row.textContent
                ).includes(
                    "manuell"
                );
            }
        );

        let fixedContent = root.querySelector(
            ".atlas-manual-header-fixed-content-v3"
        );

        if (fixedContent) {
            const counter = (
                fixedContent.querySelector(
                    ".atlas-manual-header-count-v3"
                )
            );

            if (counter) {
                counter.textContent = String(
                    manualRows.length
                );
            }

            return;
        }

        const heading = (
            findDeepestManualHeadingElement(
                root
            )
        );

        let headerContainer = (
            determineManualHeaderContainer(
                root,
                heading,
                manualTable
            )
        );

        if (!headerContainer) {
            headerContainer = (
                document.createElement(
                    "div"
                )
            );

            headerContainer.className = (
                "atlas-manual-header-fallback-v3"
            );

            manualTable.parentElement.insertBefore(
                headerContainer,
                manualTable
            );

            if (heading) {
                heading.style.display = "none";
            }
        }

        headerContainer.classList.add(
            "atlas-manual-header-container-v3"
        );

        for (
            const child
            of Array.from(
                headerContainer.children
            )
        ) {
            if (
                child.classList.contains(
                    "atlas-manual-header-fixed-content-v3"
                )
            ) {
                continue;
            }

            child.setAttribute(
                "data-atlas-manual-header-original-v3",
                "true"
            );
        }

        fixedContent = (
            buildManualHeaderContent(
                manualRows.length
            )
        );

        headerContainer.append(
            fixedContent
        );
    }


    function emphasizeKpiValues() {
        const root = document.getElementById(
            "atlas-reference-kpis"
        );

        if (!root) {
            return;
        }

        const cards = Array.from(
            root.children
        );

        const excludedWords = [
            "tage",
            "roi",
            "long",
            "short",
            "gewinne",
            "verluste",
            "verfügbar",
            "verwendet",
            "usdt",
            "offene trades",
            "gewinnquote",
            "gesamt pnl",
            "account balance",
            "total margin"
        ];

        for (const card of cards) {
            for (
                const oldValue
                of card.querySelectorAll(
                    ".atlas-kpi-primary-value-v3"
                )
            ) {
                oldValue.classList.remove(
                    "atlas-kpi-primary-value-v3"
                );
            }

            const candidates = Array.from(
                card.querySelectorAll(
                    "div, span, p, strong, output"
                )
            ).filter(
                function (element) {
                    const value = String(
                        element.textContent || ""
                    ).trim();

                    if (!value || !/\d/.test(value)) {
                        return false;
                    }

                    const normalized = (
                        normalizeText(value)
                    );

                    if (
                        excludedWords.some(
                            function (word) {
                                return normalized.includes(
                                    word
                                );
                            }
                        )
                    ) {
                        return false;
                    }

                    if (value.length > 20) {
                        return false;
                    }

                    return true;
                }
            );

            if (!candidates.length) {
                continue;
            }

            const scored = candidates.map(
                function (element) {
                    const value = String(
                        element.textContent || ""
                    ).trim();

                    const identity = normalizeText(
                        String(
                            element.id || ""
                        )
                        + " "
                        + String(
                            element.className || ""
                        )
                    );

                    let score = 0;

                    if (
                        /^[+\-]?\s*[\d.,]+\s*%?$/.test(
                            value
                        )
                    ) {
                        score += 12;
                    }

                    if (
                        identity.includes("value")
                        || identity.includes("balance")
                        || identity.includes("count")
                        || identity.includes("margin")
                        || identity.includes("pnl")
                        || identity.includes("rate")
                    ) {
                        score += 8;
                    }

                    if (value.length <= 10) {
                        score += 3;
                    }

                    const style = (
                        window.getComputedStyle(
                            element
                        )
                    );

                    const fontSize = parseFloat(
                        style.fontSize
                    );

                    if (
                        Number.isFinite(fontSize)
                    ) {
                        score += (
                            fontSize / 10
                        );
                    }

                    score -= (
                        element.children.length
                        * 0.5
                    );

                    return {
                        element,
                        score
                    };
                }
            );

            scored.sort(
                function (left, right) {
                    return (
                        right.score
                        - left.score
                    );
                }
            );

            scored[0].element.classList.add(
                "atlas-kpi-primary-value-v3"
            );
        }
    }



