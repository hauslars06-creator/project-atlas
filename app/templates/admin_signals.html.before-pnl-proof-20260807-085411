<script id="atlas-signal-bulk-selection-final">
(function(){

function start(){

    const form=document.getElementById(
        "atlas-signal-bulk-form"
    );

    if(!form)return;

    const head=document.getElementById(
        "atlas-select-page"
    );

    const visibleBtn=document.getElementById(
        "atlas-select-visible"
    );

    const filteredBtn=document.getElementById(
        "atlas-select-filtered"
    );

    const clearBtn=document.getElementById(
        "atlas-clear-selection"
    );

    const mode=document.getElementById(
        "atlas-selection-mode"
    );

    const count=document.getElementById(
        "atlas-selected-count"
    );

    const info=document.getElementById(
        "atlas-selection-info"
    );

    const idsBox=document.getElementById(
        "atlas-bulk-signal-ids"
    );

    const apply=document.getElementById(
        "atlas-bulk-apply"
    );

    const totalFiltered=
        Number("{{ signal_total_count }}") || 0;

    const FILTER_KEY=
        "atlasBulkFilteredMode";

    const IDS_KEY=
        "atlasBulkSelectedIds";


    function boxes(){
        return Array.from(
            document.querySelectorAll(
                "#signals-table .atlas-signal-checkbox"
            )
        );
    }


    function loadIds(){

        try{
            return JSON.parse(
                sessionStorage.getItem(
                    IDS_KEY
                ) || "[]"
            );
        }
        catch(e){
            return [];
        }
    }


    function saveIds(ids){

        sessionStorage.setItem(
            IDS_KEY,
            JSON.stringify(
                Array.from(
                    new Set(ids)
                )
            )
        );
    }


    function filteredMode(){

        return (
            sessionStorage.getItem(
                FILTER_KEY
            ) === "1"
        );
    }


    function setFilteredMode(value){

        if(value){
            sessionStorage.setItem(
                FILTER_KEY,
                "1"
            );
        }
        else{
            sessionStorage.removeItem(
                FILTER_KEY
            );
        }
    }


    function rebuildHiddenIds(){

        if(!idsBox)return;

        idsBox.innerHTML="";

        if(filteredMode()){
            return;
        }

        loadIds().forEach(
            function(id){

                const input=
                    document.createElement(
                        "input"
                    );

                input.type="hidden";
                input.name="signal_ids";
                input.value=id;

                idsBox.appendChild(
                    input
                );
            }
        );
    }


    function applyStoredSelection(){

        const storedIds=
            new Set(loadIds());

        if(filteredMode()){

            boxes().forEach(
                function(box){
                    box.checked=true;
                }
            );

            return;
        }

        boxes().forEach(
            function(box){
                box.checked=
                    storedIds.has(
                        box.value
                    );
            }
        );
    }


    function update(){

        applyStoredSelection();

        const all=boxes();

        const selectedVisible=
            all.filter(
                function(box){
                    return box.checked;
                }
            );

        if(filteredMode()){

            mode.value="filtered";

            count.textContent=
                totalFiltered
                +" ausgewählt";

            info.textContent=
                "Alle aktuell gefilterten Signale";

            apply.disabled=
                totalFiltered===0;

            if(head){
                head.checked=
                    all.length>0;

                head.indeterminate=false;
            }

            rebuildHiddenIds();

            return;
        }

        mode.value="selected";

        const allIds=
            loadIds();

        count.textContent=
            allIds.length
            +" ausgewählt";

        info.textContent=
            allIds.length
            ? "Auswahl über mehrere Seiten"
            : "Einzelne Signale markieren";

        apply.disabled=
            allIds.length===0;

        if(head){

            head.checked=
                all.length>0
                &&
                selectedVisible.length===all.length;

            head.indeterminate=
                selectedVisible.length>0
                &&
                selectedVisible.length<all.length;
        }

        rebuildHiddenIds();
    }


    function selectVisible(){

        setFilteredMode(false);

        const ids=
            new Set(loadIds());

        boxes().forEach(
            function(box){
                box.checked=true;
                ids.add(box.value);
            }
        );

        saveIds(
            Array.from(ids)
        );

        update();
    }


    function clearVisible(){

        setFilteredMode(false);

        const ids=
            new Set(loadIds());

        boxes().forEach(
            function(box){
                box.checked=false;
                ids.delete(box.value);
            }
        );

        saveIds(
            Array.from(ids)
        );

        update();
    }


    function selectFiltered(){

        setFilteredMode(true);

        saveIds([]);

        boxes().forEach(
            function(box){
                box.checked=true;
            }
        );

        update();
    }


    function clearAll(){

        setFilteredMode(false);
        saveIds([]);

        boxes().forEach(
            function(box){
                box.checked=false;
            }
        );

        update();
    }


    boxes().forEach(
        function(box){

            box.addEventListener(
                "change",
                function(){

                    setFilteredMode(false);

                    const ids=
                        new Set(loadIds());

                    if(box.checked){
                        ids.add(box.value);
                    }
                    else{
                        ids.delete(box.value);
                    }

                    saveIds(
                        Array.from(ids)
                    );

                    update();
                }
            );
        }
    );


    if(head){

        head.onchange=function(){

            if(head.checked){
                selectVisible();
            }
            else{
                clearVisible();
            }
        };
    }


    if(visibleBtn){

        visibleBtn.onclick=
            selectVisible;
    }


    if(filteredBtn){

        filteredBtn.onclick=
            selectFiltered;
    }


    if(clearBtn){

        clearBtn.onclick=
            clearAll;
    }


    /*
     * Auswahl bleibt über Pagination bestehen.
     * Filterwechsel setzt absichtlich keine
     * bestehende Auswahl zurück.
     */
    applyStoredSelection();
    update();


    form.addEventListener(
        "submit",
        function(event){

            const names=[
                "margin_usdt",
                "leverage",
                "take_profit_percent",
                "stop_loss_percent",
                "take_profit_2_percent"
            ];

            const changed=
                names.some(
                    function(name){

                        const input=
                            form.elements[name];

                        return (
                            input
                            &&
                            String(
                                input.value
                            ).trim()!==""
                        );
                    }
                );

            const tp2Mode =
                form.elements["take_profit_2_mode"]?.value || "UNCHANGED";

            const breakEven =
                form.elements["break_even_mode"]?.value || "";

            if(
                !changed &&
                tp2Mode==="UNCHANGED" &&
                breakEven===""
            ){

                event.preventDefault();

                alert(
                    "Bitte mindestens ein Feld ändern."
                );

                return;
            }

            const amount=
                filteredMode()
                ? totalFiltered
                : loadIds().length;

            if(amount===0){

                event.preventDefault();

                alert(
                    "Keine Signale ausgewählt."
                );

                return;
            }

            if(
                !confirm(
                    "Änderungen wirklich auf "
                    +amount
                    +" Signal"
                    +(amount===1 ? "" : "e")
                    +" anwenden?"
                )
            ){
                event.preventDefault();
                return;
            }

            /*
             * Auswahl nach erfolgreichem Submit
             * beim nächsten Laden zurücksetzen.
             */
            sessionStorage.removeItem(
                FILTER_KEY
            );

            sessionStorage.removeItem(
                IDS_KEY
            );
        }
    );
}


if(document.readyState==="loading"){

    document.addEventListener(
        "DOMContentLoaded",
        start
    );

}
else{

    start();
}

})();
</script>



