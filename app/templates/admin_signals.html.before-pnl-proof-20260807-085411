    function tpSlPercentFromPrice(trade, type, priceValue) {
        const entry = numberOrNull(trade?.entry_price);
        const price = numberOrNull(priceValue);

        if (entry === null || entry <= 0 || price === null || price <= 0) {
            return null;
        }

        const short = directionOf(trade) === "SHORT";
        let percent = null;

        if (type === "tp") {
            percent = short
                ? (entry - price) / entry * 100
                : (price - entry) / entry * 100;
        } else {
            percent = short
                ? (price - entry) / entry * 100
                : (entry - price) / entry * 100;
        }

        return Number.isFinite(percent) && percent > 0
            ? percent
            : null;
    }

    function pricesFromTpSlPercent(trade, tpPercent, slPercent) {
        const entry = numberOrNull(trade?.entry_price);
        if (entry === null || entry <= 0) {
            throw new Error("Ungültiger Entry-Preis.");
        }

        const short = directionOf(trade) === "SHORT";
        const tpPrice = short
            ? entry * (1 - tpPercent / 100)
            : entry * (1 + tpPercent / 100);
        const slPrice = short
            ? entry * (1 + slPercent / 100)
            : entry * (1 - slPercent / 100);

        if (
            !Number.isFinite(tpPrice)
            || !Number.isFinite(slPrice)
            || tpPrice <= 0
            || slPrice <= 0
        ) {
            throw new Error("Berechneter TP-/SL-Preis ist ungültig.");
        }

        return {
            tpPrice: Number(tpPrice.toFixed(12)),
            slPrice: Number(slPrice.toFixed(12))
        };
    }

