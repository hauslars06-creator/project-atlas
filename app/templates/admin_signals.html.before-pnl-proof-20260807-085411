                                    return rowHtml(
                                        trade,
                                        external
                                    );
                                }
                            ).join("")
                        }
                    </tbody>
                </table>
            </div>
        `;
    }

    function dashboardHtml(trades) {
        const externalTrades = trades.filter(
            isExternal
        );

        const atlasTrades = trades.filter(
            function (trade) {
                return !isExternal(trade);
            }
        );

        const selectable = atlasTrades.filter(
            function (trade) {
                return !Boolean(trade.is_locked);
            }
        );

        const allSelected = (
            selectable.length > 0
            && selectable.every(
                function (trade) {
                    return state.selected.has(
                        String(
                            trade.position_id ?? ""
                        )
                    );
                }
            )
        );

        return `
            <div class="atlas-reference-trades">
                <section class="
                    atlas-trade-panel
                    atlas-external-panel
                ">
                    <header class="atlas-panel-header">
                        <div class="
                            atlas-panel-title
                            atlas-external-title
                        ">
                            ${icon("pin")}

                            <span>
                                GESPERRTE TRADES
                                (MANUELL AUF BITUNIX ERÖFFNET)
                            </span>

