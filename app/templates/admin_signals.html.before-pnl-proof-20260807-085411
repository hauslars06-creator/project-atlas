<script id="atlas-bulk-smooth-transition">
(function(){

const form=document.getElementById(
    "atlas-signal-bulk-form"
);

const overlay=document.getElementById(
    "atlas-bulk-saving-overlay"
);

const toast=document.getElementById(
    "atlas-bulk-success-toast"
);

const SCROLL_KEY="atlasBulkScrollPosition";
const SAVED_KEY="atlasBulkSavePending";

if(form){

    form.addEventListener(
        "submit",
        function(event){

            /*
             * Erst reagieren, wenn der Submit
             * von keinem vorherigen Handler
             * abgebrochen wurde.
             */
            setTimeout(function(){

                if(event.defaultPrevented){
                    return;
                }

                sessionStorage.setItem(
                    SCROLL_KEY,
                    String(window.scrollY)
                );

                sessionStorage.setItem(
                    SAVED_KEY,
                    "1"
                );

                if(overlay){
                    overlay.classList.add(
                        "is-visible"
                    );
                }

                document.body.classList.add(
                    "atlas-bulk-leaving"
                );

            },0);

        }
    );
}


/*
 * Nach dem Redirect:
 * Position wiederherstellen +
 * kurze Erfolgsanzeige.
 */
if(
    sessionStorage.getItem(
        SAVED_KEY
    )==="1"
){

    sessionStorage.removeItem(
        SAVED_KEY
    );

    const savedScroll=
        Number(
            sessionStorage.getItem(
                SCROLL_KEY
            )
        );

    sessionStorage.removeItem(
        SCROLL_KEY
    );

    requestAnimationFrame(function(){

        if(
            Number.isFinite(savedScroll)
            &&
            savedScroll>=0
        ){
            window.scrollTo({
                top:savedScroll,
                behavior:"instant"
            });
        }

        if(toast){

            toast.classList.add(
                "is-visible"
            );

            setTimeout(function(){

                toast.classList.remove(
                    "is-visible"
                );

            },1800);
        }

    });
}

})();
</script>


