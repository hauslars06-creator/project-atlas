<script id="project-atlas-history-v2-script">
(function () {

    "use strict";

    const API = "/api/v1/trades/history";
    const REFRESH_MS = 5000;

    const state = {
        search: "",
        direction: "",
        symbol: "",
        timeframe: "",
        closeReason: "",
        result: "",
        status: "",
        lockScope: "",
        days: "",
        sortBy: "closed_at",
        sortDir: "desc",
        userSortActive: false,
        page: 1,
        perPage: 25,
        loading: false,
        lastSignature: "",
    };

    let searchTimer = null;

    function el(id) {
        return document.getElementById(id);
    }

    function number(value, digits = 2) {
        const parsed = Number(value);

        if (!Number.isFinite(parsed)) {
            return "–";
        }

        return parsed.toLocaleString(
            "de-DE",
            {
                minimumFractionDigits: digits,
                maximumFractionDigits: digits,
            }
        );
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function parseDate(value) {
        if (!value) {
            return null;
        }

        let normalized = String(value).trim();

        if (
            !/[zZ]$/.test(normalized)
            && !/[+-]\d{2}:?\d{2}$/.test(normalized)
        ) {
            normalized += "Z";
        }

        const date = new Date(normalized);

        if (Number.isNaN(date.getTime())) {
            return null;
        }

        return date;
    }

    function formatDate(value) {
        const date = parseDate(value);

        if (!date) {
            return "–";
        }

        return date.toLocaleString(
            "de-DE",
            {
                timeZone: "Europe/Berlin",
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
            }
        );
    }

    function formatDuration(seconds) {
        let value = Number(seconds);

        if (!Number.isFinite(value) || value < 0) {
            return "–";
        }

        value = Math.floor(value);

        const days = Math.floor(value / 86400);
        const hours = Math.floor(
            (value % 86400) / 3600
        );
        const minutes = Math.floor(
            (value % 3600) / 60
        );

        if (days > 0) {
            return `${days} T ${hours} Std ${minutes} Min`;
        }

        if (hours > 0) {
            return `${hours} Std ${minutes} Min`;
        }

        if (minutes > 0) {
            return `${minutes} Min`;
        }

        return `${value} Sek`;
    }

    function formatCloseReason(value) {
        const reason = String(
            value || ""
        )
        .trim()
        .toUpperCase();

        const labels = {
            "TAKE_PROFIT": "Take Profit",
            "STOP_LOSS": "Stop Loss",
            "MANUAL_CLOSE": "Manuell geschlossen",
            "FLASH_CLOSE": "Flash Close",
            "EMERGENCY_CLOSE": "Emergency Close",
            "BITUNIX_POSITION_CLOSED":
                "BitUnix / extern geschlossen",
            "UNKNOWN": "Unbekannt",
        };

        return (
            labels[reason]
            || String(value || "–")
        );
    }

    function signedClass(value) {
        const parsed = Number(value);

        if (!Number.isFinite(parsed)) {
            return "atlas-history-neutral";
        }

        if (parsed > 0) {
            return "atlas-history-positive";
        }

        if (parsed < 0) {
            return "atlas-history-negative";
        }

        return "atlas-history-neutral";
    }

    function buildUrl() {
        const params = new URLSearchParams();

        if (state.search) {
            params.set("search", state.search);
        }

        if (state.direction) {
            params.set("direction", state.direction);
        }

        if (state.symbol) {
            params.set("symbol", state.symbol);
        }

        if (state.timeframe) {
            params.set(
                "timeframe",
                state.timeframe
            );
        }

        if (state.closeReason) {
            params.set(
                "close_reason",
                state.closeReason
            );
        }

        if (state.result) {
            params.set(
                "result",
                state.result
            );
        }

        if (state.lockScope) {
            params.set(
                "lock_scope",
                state.lockScope
            );
        }

        if (state.status) {
            params.set(
                "status",
                state.status
            );
        }

        if (state.days) {
            params.set("days", state.days);
        }

        params.set("sort_by", state.sortBy);
        params.set("sort_dir", state.sortDir);
        params.set("page", state.page);
        params.set("per_page", state.perPage);

        return API + "?" + params.toString();
    }

    function tradeSignature(data) {
        return JSON.stringify({
            total: data.total,
            page: data.page,
            ids: (data.trades || []).map(
                trade => [
                    trade.id,
                    trade.pnl_usdt,
                    trade.pnl_percent,
                    trade.closed_at,
                ]
            ),
            stats: data.stats,
        });
    }


    function updateHistoryStatusTabs(data) {

        const trades = data.trades || [];

        let active = 0;
        let locked = 0;

        trades.forEach(function(trade) {

            if (trade.is_locked) {
                locked++;
            } else {
                active++;
            }

        });


        const all =
            document.getElementById(
                "history-status-all-count"
            );

        const activeEl =
            document.getElementById(
                "history-status-active-count"
            );

        const lockedEl =
            document.getElementById(
                "history-status-locked-count"
            );


        if (all) {
            all.textContent = data.total ?? 0;
        }

        if (activeEl) {
            activeEl.textContent = active;
        }

        if (lockedEl) {
            lockedEl.textContent = locked;
        }
    }


    function renderKpis(stats) {
        const pnl = Number(stats.total_pnl || 0);
        const roi = Number(stats.avg_roi || 0);

        el("history-kpi-trades").textContent =
            stats.trade_count ?? 0;

        el("history-kpi-pnl").innerHTML =
            `<span class="${signedClass(pnl)}">`
            + `${number(pnl, 4)} USDT`
            + `</span>`;

        el("history-kpi-roi").innerHTML =
            `<span class="${signedClass(roi)}">`
            + `${number(roi, 2)} %`
            + `</span>`;

        el("history-kpi-winrate").textContent =
            `${number(stats.win_rate || 0, 1)} %`;

        el("history-kpi-winners").textContent =
            stats.winners ?? 0;

        el("history-kpi-losers").textContent =
            stats.losers ?? 0;
    }

    function renderRows(trades) {
        const body = el("history-table-body");

        if (!trades.length) {
            body.innerHTML = `
                <tr>
                    <td
                        colspan="14"
                        class="atlas-history-loading"
                    >
                        Keine Trades für diese Filter gefunden.
                    </td>
                </tr>
            `;
            return;
        }

        body.innerHTML = trades.map(
            function (trade) {

                const pnl = Number(
                    trade.pnl_usdt
                );

                const roi = Number(
                    trade.pnl_percent
                );

                const direction = String(
                    trade.direction || ""
                ).toUpperCase();

                const directionClass =
                    direction === "LONG"
                        ? "long"
                        : "short";

                return `
                    <tr>

                        <td>
                            <div
                                class="atlas-history-signal"
                                title="${escapeHtml(
                                    trade.signal_name
                                )}"
                            >
                                ${escapeHtml(
                                    trade.signal_name
                                    || trade.signal_id
                                    || "–"
                                )}
                            </div>

                            <div class="atlas-history-subline">
                                ${escapeHtml(
                                    trade.signal_id || ""
                                )}
                            </div>
                        </td>

                        <td>
                            <strong>
                                ${escapeHtml(
                                    trade.symbol || "–"
                                )}
                            </strong>
                        </td>

                        <td>
                            <span
                                class="
                                    atlas-history-badge
                                    ${directionClass}
                                "
                            >
                                ${escapeHtml(
                                    direction || "–"
                                )}
                            </span>
                        </td>

                        <td>
                            ${escapeHtml(
                                trade.timeframe || "–"
                            )}
                        </td>

                        <td class="atlas-history-number">
                            ${number(
                                trade.entry_price,
                                2
                            )}
                        </td>

                        <td class="atlas-history-number">
                            ${number(
                                trade.exit_price,
                                2
                            )}
                        </td>

                        <td
                            class="
                                atlas-history-number
                                ${signedClass(pnl)}
                            "
                        >
                            ${
                                Number.isFinite(pnl)
                                    ? number(pnl, 4)
                                        + " USDT"
                                    : "–"
                            }
                        </td>

                        <td
                            class="
                                atlas-history-number
                                ${signedClass(roi)}
                            "
                        >
                            ${
                                Number.isFinite(roi)
                                    ? number(roi, 2)
                                        + " %"
                                    : "–"
                            }
                        </td>

                        <td class="atlas-history-number">
                            ${number(
                                trade.margin_usdt,
                                2
                            )} USDT
                        </td>

                        <td>
                            ${escapeHtml(
                                trade.leverage ?? "–"
                            )}x
                        </td>

                        <td>
                            ${escapeHtml(
                                formatCloseReason(
                                    trade.close_reason
                                )
                            )}
                        </td>

                        <td>
                            ${formatDate(
                                trade.opened_at
                            )}
                        </td>

                        <td>
                            ${formatDate(
                                trade.closed_at
                            )}
                        </td>

                        <td>
                            ${formatDuration(
                                trade.duration_seconds
                            )}
                        </td>

                    </tr>
                `;
            }
        ).join("");
    }

    function fillSelect(
        select,
        values,
        current
    ) {
        const normalized = Array.from(
            new Set(values || [])
        ).filter(Boolean);

        select.innerHTML =
            '<option value="">Alle</option>'
            + normalized.map(
                value => `
                    <option
                        value="${escapeHtml(value)}"
                    >
                        ${escapeHtml(value)}
                    </option>
                `
            ).join("");

        select.value = current || "";
    }

    function renderPagination(data) {
        const pages = el("history-pages");
        pages.innerHTML = "";

        const totalPages = Math.max(
            1,
            Number(
                data.total_pages || 1
            )
        );

        const currentPage = Math.min(
            totalPages,
            Math.max(
                1,
                Number(
                    data.page || 1
                )
            )
        );

        function addPageButton(page) {
            const button =
                document.createElement("button");

            button.type = "button";
            button.textContent = page;

            if (page === currentPage) {
                button.classList.add(
                    "active"
                );
            }

            button.addEventListener(
                "click",
                function () {
                    state.page = page;
                    loadHistory(true);
                }
            );

            pages.appendChild(button);
        }


        function addDots() {
            const dots =
                document.createElement("span");

            dots.className =
                "atlas-pagination-dots";

            dots.textContent = "…";

            pages.appendChild(dots);
        }


        /*
         * Kleine Seitenanzahl:
         * alle Seiten direkt anzeigen.
         *
         * Große Seitenanzahl:
         * erste + letzte Seite sowie
         * aktuelle Nachbarseiten anzeigen.
         */
        if (totalPages <= 7) {

            for (
                let page = 1;
                page <= totalPages;
                page += 1
            ) {
                addPageButton(page);
            }

        } else {

            const pageSet = new Set([
                1,
                totalPages,
                currentPage - 1,
                currentPage,
                currentPage + 1,
            ]);

            if (currentPage <= 3) {
                pageSet.add(2);
                pageSet.add(3);
                pageSet.add(4);
            }

            if (
                currentPage
                >= totalPages - 2
            ) {
                pageSet.add(
                    totalPages - 1
                );

                pageSet.add(
                    totalPages - 2
                );

                pageSet.add(
                    totalPages - 3
                );
            }

            const pageList =
                Array.from(pageSet)
                .filter(
                    page =>
                        page >= 1
                        && page <= totalPages
                )
                .sort(
                    (a, b) => a - b
                );

            let previousPage = null;

            pageList.forEach(
                function (page) {

                    if (
                        previousPage !== null
                        && page
                            - previousPage
                            > 1
                    ) {
                        addDots();
                    }

                    addPageButton(page);

                    previousPage = page;
                }
            );
        }

        el("history-first").disabled =
            currentPage <= 1;

        el("history-prev").disabled =
            currentPage <= 1;

        el("history-next").disabled =
            currentPage >= totalPages;

        el("history-last").disabled =
            currentPage >= totalPages;

        el("history-first").dataset.page =
            "1";

        el("history-last").dataset.page =
            String(totalPages);
    }

    async function loadHistory(force = false) {
        if (state.loading) {
            return;
        }

        state.loading = true;

        try {
            const response = await fetch(
                buildUrl(),
                {
                    cache: "no-store",
                    headers: {
                        "Accept": "application/json",
                    },
                }
            );

            if (!response.ok) {
                throw new Error(
                    `HTTP ${response.status}`
                );
            }

            const data = await response.json();

            if (!data.success) {
                throw new Error(
                    "History API meldet Fehler."
                );
            }

            state.page = Number(
                data.page || state.page
            );

            const signature =
                tradeSignature(data);

            if (
                force
                || signature !== state.lastSignature
            ) {
                renderRows(data.trades || []);
                renderKpis(data.stats || {});
                updateHistoryStatusTabs(data);
                renderPagination(data);
                updateSortHeaders();

                fillSelect(
                    el("history-symbol"),
                    data.symbols,
                    state.symbol
                );

                fillSelect(
                    el("history-timeframe"),
                    data.timeframes,
                    state.timeframe
                );

                state.lastSignature = signature;
            }

            const first = data.total
                ? (
                    (data.page - 1)
                    * data.per_page
                    + 1
                )
                : 0;

            const last = Math.min(
                data.total,
                data.page * data.per_page
            );

            el("history-result-info").textContent =
                data.total
                    ? `${first}–${last} von `
                        + `${data.total} Trades`
                    : "0 Trades";

            el("history-last-refresh").textContent =
                "Aktualisiert "
                + new Date().toLocaleTimeString(
                    "de-DE",
                    {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                    }
                );

            el(
                "atlas-history-refresh-label"
            ).textContent = "aktiv";

        } catch (error) {

            console.error(
                "Atlas History Refresh:",
                error
            );

            el(
                "atlas-history-refresh-label"
            ).textContent = "Fehler";

            el("history-last-refresh").textContent =
                "Aktualisierung fehlgeschlagen";

        } finally {
            state.loading = false;
        }
    }

    function updateResultKpis() {
        document
            .querySelectorAll(
                ".atlas-history-kpi-filter"
            )
            .forEach(function (button) {

                const value =
                    button.dataset.resultFilter
                    || "";

                button.classList.toggle(
                    "active",
                    value === state.result
                );
            });
    }


    function updateSortHeaders() {
        document
            .querySelectorAll(
                "#trade-history-table "
                + "th.atlas-history-sortable"
            )
            .forEach(function (header) {

                const arrow =
                    header.querySelector(
                        ".atlas-history-sort-arrow"
                    );

                const column =
                    header.dataset.sort;

                const active = (
                    state.userSortActive
                    && column === state.sortBy
                );

                header.classList.toggle(
                    "active",
                    active
                );

                if (!arrow) {
                    return;
                }

                if (!active) {
                    arrow.textContent = "↕";
                    return;
                }

                arrow.textContent =
                    state.sortDir === "asc"
                        ? "↑"
                        : "↓";
            });
    }


    function resetPageAndLoad() {
        state.page = 1;
        state.lastSignature = "";
        loadHistory(true);
    }

    window.atlasResetHistorySort = function () {
        state.sortBy = "closed_at";
        state.sortDir = "desc";
        state.userSortActive = false;
        state.page = 1;
        state.lastSignature = "";

        const sortSelect =
            el("history-sort");

        if (sortSelect) {
            sortSelect.value =
                "closed_at:desc";
        }

        updateSortHeaders();
    };


    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const search =
                el("history-search");

            const direction =
                el("history-direction");

            const symbol =
                el("history-symbol");

            const timeframe =
                el("history-timeframe");

            const status =
                el("history-status");

            const closeReason =
                el("history-close-reason");

            const sort =
                el("history-sort");

            const perPage =
                el("history-per-page");

            search.addEventListener(
                "input",
                function () {
                    clearTimeout(searchTimer);

                    searchTimer = setTimeout(
                        function () {
                            state.search =
                                search.value.trim();

                            resetPageAndLoad();
                        },
                        300
                    );
                }
            );

            direction.addEventListener(
                "change",
                function () {
                    state.direction =
                        direction.value;

                    resetPageAndLoad();
                }
            );

            symbol.addEventListener(
                "change",
                function () {
                    state.symbol =
                        symbol.value;

                    resetPageAndLoad();
                }
            );

            timeframe.addEventListener(
                "change",
                function () {
                    state.timeframe =
                        timeframe.value;

                    resetPageAndLoad();
                }
            );

            status.addEventListener(
                "change",
                function () {
                    state.status =
                        status.value;

                    resetPageAndLoad();
                }
            );

            closeReason.addEventListener(
                "change",
                function () {
                    state.closeReason =
                        closeReason.value;

                    resetPageAndLoad();
                }
            );

            document
                .querySelectorAll(
                    ".atlas-history-status-tab"
                )
                .forEach(function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            state.lockScope =
                                button.dataset.statusFilter
                                || "";

                            document
                                .querySelectorAll(
                                    ".atlas-history-status-tab"
                                )
                                .forEach(function (tab) {
                                    tab.classList.toggle(
                                        "active",
                                        tab === button
                                    );
                                });

                            resetPageAndLoad();
                        }
                    );

                });


            document
                .querySelectorAll(
                    ".atlas-history-kpi-filter"
                )
                .forEach(function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            const value =
                                button.dataset
                                    .resultFilter
                                || "";

                            if (
                                state.result !== value
                            ) {
                                state.result = value;
                                state.status = "";
                            }

                            else if (
                                state.status === ""
                            ) {
                                state.status = "ACTIVE";
                            }

                            else if (
                                state.status === "ACTIVE"
                            ) {
                                state.status = "LOCKED";
                            }

                            else {
                                state.result = "";
                                state.status = "";
                            }

                            state.page = 1;
                            state.lastSignature = "";

                            updateResultKpis();
                            loadHistory(true);
                        }
                    );
                });



            document
                .querySelectorAll(
                    "#trade-history-table "
                    + "th.atlas-history-sortable"
                )
                .forEach(function (header) {

                    header.addEventListener(
                        "click",
                        function () {

                            const column =
                                header.dataset.sort;

                            state.userSortActive = true;

                            if (!column) {
                                return;
                            }

                            if (
                                state.sortBy
                                === column
                            ) {
                                state.sortDir =
                                    state.sortDir
                                    === "desc"
                                        ? "asc"
                                        : "desc";
                            } else {
                                state.sortBy =
                                    column;

                                /*
                                 * Numerische / zeitliche
                                 * Werte standardmäßig:
                                 * größte / neueste zuerst.
                                 *
                                 * Textwerte:
                                 * A-Z zuerst.
                                 */
                                if (
                                    [
                                        "signal",
                                        "symbol",
                                        "direction",
                                        "timeframe",
                                        "reason",
                                    ].includes(
                                        column
                                    )
                                ) {
                                    state.sortDir =
                                        "asc";
                                } else {
                                    state.sortDir =
                                        "desc";
                                }
                            }

                            const value =
                                state.sortBy
                                + ":"
                                + state.sortDir;

                            if (
                                Array.from(
                                    sort.options
                                ).some(
                                    option =>
                                        option.value
                                        === value
                                )
                            ) {
                                sort.value =
                                    value;
                            }

                            updateSortHeaders();
                            resetPageAndLoad();
                        }
                    );
                });


            sort.addEventListener(
                "change",
                function () {
                    const [
                        sortBy,
                        sortDir
                    ] = sort.value.split(":");

                    state.sortBy = sortBy;
                    state.sortDir = sortDir;
                    state.userSortActive = true;

                    updateSortHeaders();
                    resetPageAndLoad();
                }
            );

            perPage.addEventListener(
                "change",
                function () {
                    state.perPage =
                        Number(perPage.value);

                    resetPageAndLoad();
                }
            );

            document
                .querySelectorAll(
                    ".atlas-history-periods button"
                )
                .forEach(
                    function (button) {

                        button.addEventListener(
                            "click",
                            function () {

                                document
                                    .querySelectorAll(
                                        ".atlas-history-periods button"
                                    )
                                    .forEach(
                                        item =>
                                            item.classList.remove(
                                                "active"
                                            )
                                    );

                                button.classList.add(
                                    "active"
                                );

                                state.days =
                                    button.dataset.days;

                                resetPageAndLoad();
                            }
                        );
                    }
                );

            el("history-first").addEventListener(
                "click",
                function () {
                    if (state.page <= 1) {
                        return;
                    }

                    state.page = 1;
                    loadHistory(true);
                }
            );


            el("history-prev").addEventListener(
                "click",
                function () {
                    if (state.page > 1) {
                        state.page -= 1;
                        loadHistory(true);
                    }
                }
            );

            el("history-next").addEventListener(
                "click",
                function () {
                    state.page += 1;
                    loadHistory(true);
                }
            );

            el("history-reset").addEventListener(
                "click",
                function () {

                    state.search = "";
                    state.direction = "";
                    state.symbol = "";
                    state.timeframe = "";
                    state.closeReason = "";
                    state.days = "";
                    state.sortBy = "closed_at";
                    state.sortDir = "desc";
                    state.userSortActive = false;
                    state.page = 1;
                    state.perPage = 25;

                    search.value = "";
                    direction.value = "";
                    symbol.value = "";
                    timeframe.value = "";
                    closeReason.value = "";
                    sort.value =
                        "closed_at:desc";
                    perPage.value = "25";

                    updateSortHeaders();

                    document
                        .querySelectorAll(
                            ".atlas-history-periods button"
                        )
                        .forEach(
                            button =>
                                button.classList.toggle(
                                    "active",
                                    button.dataset.days === ""
                                )
                        );

                    resetPageAndLoad();
                }
            );

            el("history-last").addEventListener(
                "click",
                function () {
                    const page = Number(
                        el("history-last")
                            .dataset.page
                        || state.page
                    );

                    if (
                        !Number.isFinite(page)
                        || page <= state.page
                    ) {
                        return;
                    }

                    state.page = page;
                    loadHistory(true);
                }
            );


            updateSortHeaders();
            updateResultKpis();
            loadHistory(true);

            window.setInterval(
                function () {
                    loadHistory(false);
                },
                REFRESH_MS
            );
        }
    );

})();
</script>

