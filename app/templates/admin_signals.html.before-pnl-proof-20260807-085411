    async function apiPost(url, body = null) {
        const options = {
            method: "POST",
            headers: {
                "Accept": "application/json"
            }
        };

        if (body !== null) {
            options.headers[
                "Content-Type"
            ] = "application/json";

            options.body = JSON.stringify(body);
        }

        const response = await fetch(url, options);

        const payload = await response.json().catch(
            function () {
                return null;
            }
        );

        if (
            !response.ok
            || payload?.success === false
        ) {
            throw new Error(
                payload?.detail
                || payload?.message
                || "Aktion fehlgeschlagen."
            );
        }

        return payload;
    }

    async function refreshOpenTrades(force = false) {
        if (state.requestRunning) {
            return;
        }

        state.requestRunning = true;

        try {
            const response = await fetch(
                "/api/v1/trades/open",
                {
                    cache: "no-store",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            const payload = await response.json();

            if (
                !response.ok
                || !payload?.success
            ) {
                throw new Error(
                    payload?.detail
                    || "Trades konnten nicht geladen werden."
                );
            }

            const trades = Array.isArray(
                payload.trades
            )
                ? payload.trades
                : [];

            state.trades = new Map(
                trades.map(
                    function (trade) {
                        return [
                            String(
                                trade.position_id ?? ""
                            ),
                            trade
                        ];
                    }
                )
            );

            for (
                const positionId
                of Array.from(state.selected)
            ) {
                const trade = state.trades.get(
                    positionId
                );

                if (
                    !trade
                    || isExternal(trade)
                    || Boolean(trade.is_locked)
                ) {
                    state.selected.delete(positionId);
                }
            }

            const signature = staticSignature(trades);

            if (
                force
                || signature !== state.structureSignature
            ) {
                render(trades);
                state.structureSignature = signature;
            } else {
                updateDynamicRows();
                syncSelectionControls();
            }

            updateKpis(trades);
            updateSyncStatus(false);
        } catch (error) {
            console.error(
                "M5.3c Live-Sync fehlgeschlagen:",
                error
            );

            updateSyncStatus(true);
        } finally {
            state.requestRunning = false;
        }
    }

