    function multiTpSlEditorHtml(trade, preferredType = "") {
        const orders = Array.isArray(trade.tpsl_orders)
            ? trade.tpsl_orders
            : [];

        const selectedType = (
            preferredType === "tp" || preferredType === "sl"
        ) ? preferredType : "";

        let tpNumber = 0;
        let slNumber = 0;

        const cards = orders.map(function (order) {
            const rows = [];
            const tpPrice = numberOrNull(order.tp_price);
            const slPrice = numberOrNull(order.sl_price);

            if (
                tpPrice > 0
                && (selectedType === "" || selectedType === "tp")
            ) {
                tpNumber += 1;
                rows.push(
                    multiTpSlLevelRowHtml(
                        trade,
                        order,
                        "tp",
                        tpNumber
                    )
                );
            }

            if (
                slPrice > 0
                && (selectedType === "" || selectedType === "sl")
            ) {
                slNumber += 1;
                rows.push(
                    multiTpSlLevelRowHtml(
                        trade,
                        order,
                        "sl",
                        slNumber
                    )
                );
            }

            if (!rows.length) {
                return "";
            }

            const orderId = String(order.order_id ?? "");
            const shortId = orderId.length > 12
                ? "…" + orderId.slice(-12)
                : orderId;

            return `
                <section
                    class="atlas-multi-tpsl-order"
                    data-editor-type="${escapeHtml(selectedType || "all")}"
                >
                    <header class="atlas-multi-tpsl-order-header">
                        <span>BitUnix-Auftrag</span>
                        <span title="${escapeHtml(orderId)}">
                            ${escapeHtml(shortId)}
                        </span>
                    </header>
                    ${rows.join("")}
                </section>
            `;
        }).filter(Boolean);

        let title = "TP- und SL-Level";
        let empty = "Keine bearbeitbaren TP-/SL-Level gefunden.";

        if (selectedType === "tp") {
            title = "Take-Profit-Level";
            empty = "Für diesen Trade ist aktuell kein TP-Level vorhanden.";
        } else if (selectedType === "sl") {
            title = "Stop-Loss-Level";
            empty = "Für diesen Trade ist aktuell kein SL-Level vorhanden.";
        }

        return `
            <div
                class="atlas-multi-tpsl-note"
                data-selected-editor-type="${escapeHtml(selectedType || "all")}"
            >
                <strong>${escapeHtml(title)}</strong><br>
                Prozentwerte sind reine Preisabstände vom Entry.
                Hebel, Margin und ROI werden nicht verwendet.
            </div>
            ${cards.length
                ? cards.join("")
                : `<div class="atlas-multi-tpsl-note">${escapeHtml(empty)}</div>`
            }
        `;
    }

    function updateMultiTpSlInputPreview(
        modal,
        input
    ) {
        const row = input.closest(
            ".atlas-multi-tpsl-level-row"
        );

        const preview = row?.querySelector(
            ".atlas-multi-tpsl-price-preview"
        );

        if (!row || !preview) {
            return;
        }

        const ids = JSON.parse(
            modal.dataset.positionIds || "[]"
        );

        const trade = state.trades.get(
            String(ids[0] ?? "")
        );

        if (!trade) {
            preview.textContent = "–";
            return;
        }

        const type = String(
            row.dataset.levelType ?? ""
        );

        const percent = Number(
            input.value
        );

        try {
            const price = priceFromEntryPercent(
                trade,
                type,
                percent
            );

            preview.textContent = formatPrice(
                price
            );

        } catch (error) {
            preview.textContent = "Ungültig";
        }
    }


    function openMultiTpSlEditor(trade, preferredType = "") {
        const positionId = String(trade.position_id ?? "");
        const selectedType = (
            preferredType === "tp" || preferredType === "sl"
        ) ? preferredType : "";

        const modal = ensureModal();
        ensureTpSlPreviewElements(modal);

        modal.dataset.mode = "multi-percent";
        modal.dataset.positionIds = JSON.stringify([positionId]);
        modal.dataset.targetType = selectedType;

        const typeTitle = selectedType === "tp"
            ? "Take Profit"
            : (selectedType === "sl" ? "Stop Loss" : "TP/SL");

        modal.querySelector("#atlas-modal-title").textContent = (
            typeTitle + " in Prozent bearbeiten"
        );

        modal.querySelector("#atlas-modal-context").textContent = (
            String(trade.symbol ?? "")
            + " · " + directionOf(trade)
            + " · Entry " + formatPrice(trade.entry_price)
            + " · Preisabstand, nicht ROI"
        );

        setMultiTpSlMode(modal, true);

        const editor = ensureMultiTpSlEditor(modal);
        editor.innerHTML = multiTpSlEditorHtml(trade, selectedType);

        const inputs = Array.from(
            editor.querySelectorAll(".atlas-multi-tpsl-input")
        );

        inputs.forEach(function (input) {
            updateMultiTpSlInputPreview(modal, input);
        });

        const saveButton = modal.querySelector(
            '[data-action="modal-save"], #atlas-modal-save'
        );

        if (saveButton) {
            saveButton.disabled = inputs.length === 0;
            saveButton.title = inputs.length === 0
                ? "Für diese Spalte ist kein bearbeitbares Level vorhanden."
                : "";
        }

        modal.hidden = false;
        document.body.classList.add("atlas-modal-open");
        inputs[0]?.focus();
    }

    function openSingleTpSl(
        positionId,
        preferredType = ""
    ) {
        const trade = state.trades.get(
            positionId
        );

        if (!trade) {
            toast(
                "Trade nicht gefunden.",
                "error"
            );
            return;
        }

        if (Boolean(trade.is_locked)) {
            toast(
                "Trade ist gesperrt. Bitte zuerst entsperren.",
                "error"
            );
            return;
        }

        const tpCount = Number(
            trade.tp_level_count
            ?? normalizedTpSlLevels(
                trade,
                "tp"
            ).length
        );

        const slCount = Number(
            trade.sl_level_count
            ?? normalizedTpSlLevels(
                trade,
                "sl"
            ).length
        );

        if (
            Boolean(trade.has_multiple_tpsl)
            || tpCount > 1
            || slCount > 1
        ) {
            openMultiTpSlEditor(
                trade,
                preferredType
            );
            return;
        }

        const modal = ensureModal();
        ensureTpSlPreviewElements(modal);
        setMultiTpSlMode(modal, false);

        modal.dataset.mode = "single-percent";
        modal.dataset.positionIds = JSON.stringify(
            [positionId]
        );

        modal.querySelector(
            "#atlas-modal-title"
        ).textContent = (
            "TP/SL in Prozent bearbeiten"
        );

        modal.querySelector(
            "#atlas-modal-context"
        ).textContent = (
            String(trade.symbol ?? "")
            + " · "
            + directionOf(trade)
            + " · Entry "
            + formatPrice(trade.entry_price)
            + " · nicht ROI"
        );

        modal.querySelector(
            "#atlas-modal-tp-label"
        ).textContent = (
            "Take Profit (%) – Preisabstand vom Entry"
        );

        modal.querySelector(
            "#atlas-modal-sl-label"
        ).textContent = (
            "Stop Loss (%) – Preisabstand vom Entry"
        );

        const tpPercent = tpSlPercentFromPrice(
            trade,
            "tp",
            trade.tp_price
        );

        const slPercent = tpSlPercentFromPrice(
            trade,
            "sl",
            trade.sl_price
        );

        modal.querySelector(
            "#atlas-modal-tp"
        ).value = (
            tpPercent === null
                ? ""
                : Number(tpPercent.toFixed(6))
        );

        modal.querySelector(
            "#atlas-modal-sl"
        ).value = (
            slPercent === null
                ? ""
                : Number(slPercent.toFixed(6))
        );

        updateTpSlPercentPreview(modal);

        modal.hidden = false;
        document.body.classList.add(
            "atlas-modal-open"
        );

        modal.querySelector(
            preferredType === "sl"
                ? "#atlas-modal-sl"
                : "#atlas-modal-tp"
        ).focus();
    }


    function openBulkTpSl() {
        const ids = Array.from(
            state.selected
        ).filter(
            function (positionId) {
                const trade = state.trades.get(
                    positionId
                );

                return (
                    trade
                    && !isExternal(trade)
                    && !Boolean(trade.is_locked)
                );
            }
        );

        if (!ids.length) {
            toast(
                "Bitte mindestens einen Trade auswählen.",
                "error"
            );
            return;
        }

        const multiLevelTrade = ids
            .map(
                function (positionId) {
                    return state.trades.get(
                        positionId
                    );
                }
            )
            .find(
                function (trade) {
                    return Boolean(
                        trade?.has_multiple_tpsl
                    );
                }
            );

        if (multiLevelTrade) {
            toast(
                (
                    "Mehrere Level werden pro Trade über "
                    + "den jeweiligen Stift bearbeitet."
                ),
                "error"
            );
            return;
        }

        const modal = ensureModal();
        ensureTpSlPreviewElements(modal);
        setMultiTpSlMode(modal, false);

        modal.dataset.mode = "bulk-percent";
        modal.dataset.positionIds = JSON.stringify(
            ids
        );

        modal.querySelector(
            "#atlas-modal-title"
        ).textContent = (
            "TP/SL für Auswahl in Prozent"
        );

        modal.querySelector(
            "#atlas-modal-context"
        ).textContent = (
            ids.length
            + " ausgewählte Trades. Preisabstand vom Entry, nicht ROI."
        );

        modal.querySelector(
            "#atlas-modal-tp-label"
        ).textContent = (
            "Take Profit (%) – Preisabstand vom Entry"
        );

        modal.querySelector(
            "#atlas-modal-sl-label"
        ).textContent = (
            "Stop Loss (%) – Preisabstand vom Entry"
        );

        modal.querySelector(
            "#atlas-modal-tp"
        ).value = "";

        modal.querySelector(
            "#atlas-modal-sl"
        ).value = "";

        updateTpSlPercentPreview(modal);

        modal.hidden = false;
        document.body.classList.add(
            "atlas-modal-open"
        );

        modal.querySelector(
            "#atlas-modal-tp"
        ).focus();
    }


    function closeModal() {
        const modal = document.getElementById(
            "atlas-reference-modal"
        );

        if (modal) {
            modal.hidden = true;
        }

        document.body.classList.remove(
            "atlas-modal-open"
        );
    }


    function collectMultiTpSlUpdates(
        modal,
        trade
    ) {
        const updates = new Map();

        modal.querySelectorAll(
            ".atlas-multi-tpsl-level-row"
        ).forEach(
            function (row) {
                const input = row.querySelector(
                    ".atlas-multi-tpsl-input"
                );

                if (!input) {
                    return;
                }

                const orderId = String(
                    row.dataset.orderId ?? ""
                ).trim();

                const levelType = String(
                    row.dataset.levelType ?? ""
                ).trim();

                const percent = Number(
                    input.value
                );

                const originalPercent = Number(
                    input.dataset.originalPercent
                );

                if (
                    !orderId
                    || !["tp", "sl"].includes(levelType)
                ) {
                    throw new Error(
                        "Ungültige TP-/SL-Level-Zuordnung."
                    );
                }

                if (
                    !Number.isFinite(percent)
                    || percent <= 0
                    || percent >= 100
                ) {
                    throw new Error(
                        "Alle Prozentwerte müssen größer als 0 und kleiner als 100 sein."
                    );
                }

                priceFromEntryPercent(
                    trade,
                    levelType,
                    percent
                );

                if (
                    Number.isFinite(originalPercent)
                    && Math.abs(
                        percent - originalPercent
                    ) <= 1e-9
                ) {
                    return;
                }

                const payload = updates.get(
                    orderId
                ) || {
                    orderId: orderId
                };

                payload[
                    levelType + "_percent"
                ] = percent;

                updates.set(
                    orderId,
                    payload
                );
            }
        );

        return Array.from(
            updates.values()
        );
    }


    async function saveModal(button) {
        const modal = document.getElementById(
            "atlas-reference-modal"
        );

        if (!modal) {
            return;
        }

        const ids = JSON.parse(
            modal.dataset.positionIds || "[]"
        );

        const mode = String(
            modal.dataset.mode ?? ""
        );

        const original = button.textContent;

        try {
            if (mode === "multi-percent") {
                const positionId = String(
                    ids[0] ?? ""
                );

                const trade = state.trades.get(
                    positionId
                );

                if (!trade) {
                    throw new Error(
                        "Trade wurde nicht gefunden."
                    );
                }

                if (Boolean(trade.is_locked)) {
                    throw new Error(
                        "Trade ist gesperrt. Bitte zuerst entsperren."
                    );
                }

                const updates = collectMultiTpSlUpdates(
                    modal,
                    trade
                );

                if (!updates.length) {
                    toast(
                        "Es wurden keine Werte verändert.",
                        "error"
                    );
                    return;
                }

                const confirmed = window.confirm(
                    updates.length
                    + " vorhandene(n) TP-/SL-Auftrag wirklich "
                    + "ändern?\n\n"
                    + "Die Prozentwerte beziehen sich auf den Entry-Preis, nicht auf ROI."
                );

                if (!confirmed) {
                    return;
                }

                button.disabled = true;
                button.textContent = "Speichert …";

                for (const update of updates) {
                    const payload = {};

                    if (
                        Number.isFinite(
                            update.tp_percent
                        )
                    ) {
                        payload.tp_percent = (
                            update.tp_percent
                        );
                    }

                    if (
                        Number.isFinite(
                            update.sl_percent
                        )
                    ) {
                        payload.sl_percent = (
                            update.sl_percent
                        );
                    }

                    await apiPost(
                        "/api/v1/trades/"
                        + encodeURIComponent(positionId)
                        + "/tpsl-orders/"
                        + encodeURIComponent(update.orderId),
                        payload
                    );
                }

                closeModal();

                toast(
                    (
                        "Die geänderten TP-/SL-Level wurden "
                        + "aus Entry-Prozenten berechnet und "
                        + "an BitUnix übermittelt."
                    ),
                    "success"
                );

                window.setTimeout(
                    function () {
                        refreshOpenTrades(true);
                    },
                    900
                );

                return;
            }

            const tpPercent = Number(
                modal.querySelector(
                    "#atlas-modal-tp"
                ).value
            );

            const slPercent = Number(
                modal.querySelector(
                    "#atlas-modal-sl"
                ).value
            );

            if (
                !Number.isFinite(tpPercent)
                || !Number.isFinite(slPercent)
                || tpPercent <= 0
                || slPercent <= 0
            ) {
                toast(
                    "Bitte gültige positive Prozentwerte eingeben.",
                    "error"
                );
                return;
            }

            if (
                tpPercent >= 100
                || slPercent >= 100
            ) {
                toast(
                    "TP und SL müssen jeweils kleiner als 100 % sein.",
                    "error"
                );
                return;
            }

            button.disabled = true;
            button.textContent = "Speichert …";

            for (const positionId of ids) {
                const trade = state.trades.get(
                    String(positionId)
                );

                if (!trade) {
                    continue;
                }

                if (Boolean(trade.has_multiple_tpsl)) {
                    throw new Error(
                        (
                            "Mehrere Level bitte über den "
                            + "Stift des einzelnen Trades bearbeiten."
                        )
                    );
                }

                const prices = pricesFromTpSlPercent(
                    trade,
                    tpPercent,
                    slPercent
                );

                await apiPost(
                    "/api/v1/trades/"
                    + encodeURIComponent(positionId)
                    + "/tpsl",
                    {
                        tp_price: prices.tpPrice,
                        sl_price: prices.slPrice
                    }
                );
            }

            closeModal();

            toast(
                (
                    "TP und SL wurden aus Entry-Prozenten "
                    + "berechnet und an BitUnix übermittelt."
                ),
                "success"
            );

            window.setTimeout(
                function () {
                    refreshOpenTrades(true);
                },
                700
            );

        } catch (error) {
            toast(
                error instanceof Error
                    ? error.message
                    : "TP/SL konnte nicht geändert werden.",
                "error"
            );

        } finally {
            button.disabled = false;
            button.textContent = original;
        }
    }


    async function toggleLock(positionId, button) {
        const trade = state.trades.get(positionId);

        if (!trade) {
            return;
        }

        const locked = Boolean(trade.is_locked);

        if (
            !window.confirm(
                locked
                    ? "Diesen Trade wirklich entsperren?"
                    : "Diesen Trade wirklich sperren?"
            )
        ) {
            return;
        }

        button.disabled = true;

        try {
            await apiPost(
                "/api/v1/trades/"
                + encodeURIComponent(positionId)
                + "/"
                + (locked ? "unlock" : "lock")
            );

            toast(
                locked
                    ? "Trade wurde entsperrt."
                    : "Trade wurde gesperrt.",
                "success"
            );

            await refreshOpenTrades(true);
        } catch (error) {
            toast(
                error instanceof Error
                    ? error.message
                    : "Sperrstatus konnte nicht geändert werden.",
                "error"
            );
        } finally {
            button.disabled = false;
        }
    }

    async function closeOne(positionId, button) {
        const trade = state.trades.get(positionId);

        if (!trade) {
            return;
        }

        if (Boolean(trade.is_locked)) {
            toast(
                "Trade ist gesperrt. Bitte zuerst entsperren.",
                "error"
            );
            return;
        }

        if (
            !window.confirm(
                String(trade.symbol ?? positionId)
                + " wirklich vollständig schließen?"
            )
        ) {
            return;
        }

        button.disabled = true;

        try {
            await apiPost(
                "/api/v1/trades/"
                + encodeURIComponent(positionId)
                + "/close"
            );

            toast(
                "Schließung wurde von BitUnix angenommen.",
                "success"
            );

            window.setTimeout(
                function () {
                    refreshOpenTrades(true);
                },
                700
            );
        } catch (error) {
            toast(
                error instanceof Error
                    ? error.message
                    : "Trade konnte nicht geschlossen werden.",
                "error"
            );
        } finally {
            button.disabled = false;
        }
    }

    async function closeAll(button) {
        if (
            !window.confirm(
                "Alle entsperrten Trades schließen?\n\n"
                + "Gesperrte Trades werden übersprungen."
            )
        ) {
            return;
        }

        const original = button.textContent;
        button.disabled = true;
        button.textContent = "Trades werden geschlossen …";

        try {
            const payload = await apiPost(
                "/api/v1/trades/close-all"
                + "?confirm=true"
            );

            toast(
                String(
                    payload?.closed_request_count
                    ?? 0
                )
                + " Schließanfragen angenommen.",
                "success"
            );

            window.setTimeout(
                function () {
                    refreshOpenTrades(true);
                },
                900
            );
        } catch (error) {
            toast(
                error instanceof Error
                    ? error.message
                    : "Trades konnten nicht geschlossen werden.",
                "error"
            );
        } finally {
            button.disabled = false;
            button.textContent = original;
        }
    }

    function showMarginInfo() {
        window.alert(
            "Margin+ ist optisch vorbereitet.\n\n"
            + "Die aktuellen Atlas-Positionen verwenden "
            + "CROSS Margin. Eine Vergrößerung würde "
            + "eine neue Order auslösen und wird deshalb "
            + "erst mit einer separaten Sicherheitslogik "
            + "aktiviert."
        );
    }

    document.addEventListener(
        "click",
        function (event) {
            if (!(event.target instanceof Element)) {
                return;
            }

            const control = event.target.closest(
                "[data-action]"
            );

            if (!control) {
                return;
            }

            const action = control.dataset.action;

            if (!action) {
                return;
            }

            event.preventDefault();
            event.stopImmediatePropagation();

            const positionId = String(
                control.dataset.positionId ?? ""
            );

            if (action === "refresh") {
                refreshOpenTrades(true);
            } else if (action === "margin-info") {
                showMarginInfo();
            } else if (action === "edit-tpsl") {
                openSingleTpSl(
                    positionId,
                    String(
                        control.dataset.targetType
                        ?? ""
                    )
                );
            } else if (action === "bulk-tpsl") {
                openBulkTpSl();
            } else if (action === "toggle-lock") {
                toggleLock(positionId, control);
            } else if (action === "close-one") {
                closeOne(positionId, control);
            } else if (action === "close-all") {
                closeAll(control);
            } else if (action === "modal-close") {
                closeModal();
            } else if (action === "modal-save") {
                saveModal(control);
            }
        },
        true
    );

    document.addEventListener(
        "change",
        function (event) {
            if (
                !(
                    event.target
                    instanceof HTMLInputElement
                )
            ) {
                return;
            }

            if (
                event.target.id
                === "atlas-select-all-trades"
            ) {
                for (
                    const trade
                    of state.trades.values()
                ) {
                    if (
                        isExternal(trade)
                        || Boolean(trade.is_locked)
                    ) {
                        continue;
                    }

                    const positionId = String(
                        trade.position_id ?? ""
                    );

                    if (event.target.checked) {
                        state.selected.add(positionId);
                    } else {
                        state.selected.delete(positionId);
                    }
                }

                document
                    .querySelectorAll(
                        ".atlas-trade-checkbox"
                        + ":not(:disabled)"
                    )
                    .forEach(
                        function (checkbox) {
                            checkbox.checked = (
                                event.target.checked
                            );
                        }
                    );

                syncSelectionControls();
                return;
            }

            if (
                event.target.classList.contains(
                    "atlas-trade-checkbox"
                )
            ) {
                const positionId = String(
                    event.target.dataset.positionId
                    ?? ""
                );

                if (event.target.checked) {
                    state.selected.add(positionId);
                } else {
                    state.selected.delete(positionId);
                }

                syncSelectionControls();
            }
        },
        true
    );

    document.addEventListener(
        "keydown",
        function (event) {
            if (event.key === "Escape") {
                closeModal();
            }
        }
    );

    document.addEventListener(
        "DOMContentLoaded",
        function () {
            refreshOpenTrades(true);

            window.setInterval(
                refreshOpenTrades,
                REFRESH_MS
            );

            window.setInterval(
                updateDurations,
                1000
            );
        }
    );

    window.atlasRefreshOpenTrades = refreshOpenTrades;
})();
</script>









<script id="project-atlas-m53f2-layout-navigation-pin-script">
(function () {
    "use strict";

    const VIEW_CLASSES = [
        "atlas-view-dashboard",
        "atlas-view-history",
        "atlas-view-signals",
        "atlas-view-statistics",
        "atlas-view-signal-performance"
    ];

    let pendingStatisticsPreset = null;
    let pinUpdateScheduled = false;


    function normalizeText(value) {
        return String(value || "")
            .toLocaleLowerCase("de-DE")
            .replace(/\s+/g, " ")
            .trim();
    }


    function getSidebarLinks() {
        return Array.from(
            document.querySelectorAll(
                "#atlas-sidebar a, "
                + ".atlas-sidebar a, "
                + "aside a"
            )
        );
    }


    function configureSidebarLinks() {
        for (const link of getSidebarLinks()) {
            const label = normalizeText(
                link.textContent
            );

            if (label === "dashboard") {
                link.setAttribute(
                    "href",
                    "#atlas-reference-kpis"
                );
            }

            if (label === "offene trades") {
                link.setAttribute(
                    "href",
                    "#atlas-open-trades"
                );
            }

            if (label === "trade historie") {
                link.setAttribute(
                    "href",
                    "#atlas-trade-history"
                );
            }

            if (label === "signale") {
                link.setAttribute(
                    "href",
                    "#atlas-signals"
                );
            }

            if (label === "signale verwalten") {
                link.setAttribute(
                    "href",
                    "#atlas-signal-form"
                );
            }

            if (label === "übersicht") {
                link.setAttribute(
                    "href",
                    "#atlas-statistics-dashboard"
                );

                link.dataset.atlasStatisticsPreset = (
                    "overview"
                );
            }

            if (label === "tagesstatistik") {
                link.setAttribute(
                    "href",
                    "#atlas-statistics-dashboard"
                );

                link.dataset.atlasStatisticsPreset = (
                    "day"
                );
            }

            if (label === "wochenstatistik") {
                link.setAttribute(
                    "href",
                    "#atlas-statistics-dashboard"
                );

                link.dataset.atlasStatisticsPreset = (
                    "week"
                );
            }

            if (label === "monatsstatistik") {
                link.setAttribute(
                    "href",
                    "#atlas-statistics-dashboard"
                );

                link.dataset.atlasStatisticsPreset = (
                    "month"
                );
            }

            if (label === "performance je signal") {
                link.setAttribute(
                    "href",
                    "#atlas-signal-performance"
                );
            }
        }
    }


    function resolveView() {
        const hash = normalizeText(
            window.location.hash
        );

        if (
            hash === "#atlas-trade-history"
        ) {
            return "history";
        }

        if (
            hash === "#atlas-signals"
            || hash === "#atlas-signal-form"
        ) {
            return "signals";
        }

        if (
            hash === "#atlas-signal-performance"
        ) {
            return "signal-performance";
        }

        if (
            hash.startsWith(
                "#atlas-statistics"
            )
        ) {
            return "statistics";
        }

        return "dashboard";
    }


    function clearSignalPerformanceFocus() {
        const root = document.getElementById(
            "atlas-statistics-dashboard"
        );

        if (!root) {
            return;
        }

        for (
            const element
            of root.querySelectorAll(
                "[data-atlas-signal-focus-parent], "
                + "[data-atlas-signal-performance-root]"
            )
        ) {
            element.removeAttribute(
                "data-atlas-signal-focus-parent"
            );

            element.removeAttribute(
