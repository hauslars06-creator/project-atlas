<script id="project-atlas-kpi-collapse-final">
(function () {
    "use strict";


    function updateButton(
        button,
        collapsed
    ) {

        const symbol =
            button.querySelector(
                "#atlas-kpi-collapse-symbol"
            );

        const label =
            button.querySelector(
                "#atlas-kpi-collapse-label"
            );


        button.setAttribute(
            "aria-expanded",
            collapsed
                ? "false"
                : "true"
        );


        if (symbol) {

            symbol.textContent =
                collapsed
                    ? "+"
                    : "−";
        }


        if (label) {

            label.textContent =
                collapsed
                    ? "Kennzahlen anzeigen"
                    : "Kennzahlen einklappen";
        }
    }


    /*
     * Event Delegation:
     *
     * Listener hängt am document und bleibt deshalb
     * auch dann aktiv, wenn Dashboard-Elemente später
     * aktualisiert oder neu gerendert werden.
     */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    "#atlas-kpi-collapse-toggle"
                );


            if (!button) {
                return;
            }


            event.preventDefault();
            event.stopPropagation();


            const section =
                document.getElementById(
                    "atlas-reference-kpis"
                );


            if (!section) {

                console.error(
                    "Atlas KPI Section nicht gefunden."
                );

                return;
            }


            const collapsed =
                section.classList.toggle(
                    "is-collapsed"
                );


            updateButton(
                button,
                collapsed
            );
        }
    );


    /*
     * Beim Laden immer sauberer Ausgangszustand:
     * Kennzahlen sichtbar.
     *
     * Der Zustand wird bewusst NICHT gespeichert.
     */

    function initialize() {

        const section =
            document.getElementById(
                "atlas-reference-kpis"
            );

        const button =
            document.getElementById(
                "atlas-kpi-collapse-toggle"
            );


        if (!section || !button) {
            return;
        }


        section.classList.remove(
            "is-collapsed"
        );


        updateButton(
            button,
            false
        );
    }


    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initialize,
            {
                once: true
            }
        );

    } else {

        initialize();
    }

})();
</script>


