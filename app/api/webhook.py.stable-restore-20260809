            if has_tp2
            else None
        ),
        "tp1_quantity": str(tp1_qty),
        "tp2_quantity": (
            str(tp2_qty)
            if has_tp2
            else None
        ),
        "runner_quantity": (
            str(runner_qty)
            if has_tp2
            else None
        ),
        "break_even_mode": break_even_mode,
        "sl_price": str(sl_price),
        "order_response": order_result,
